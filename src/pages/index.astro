---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { medias } from '../data/medias';
import PartnerEdgward from '../components/PartnerEdgward.astro';
import TrustBar from '../components/TrustBar.astro';

const pillars = [
  {
    title: 'Nous concevons et nous éprouvons',
    text: "Nous ne livrons pas qu'un document : nous testons votre dispositif en conditions réelles - exercices grandeur nature, tests d'intrusion - pour révéler les failles avant le jour J.",
  },
  {
    title: 'Un conseil indépendant',
    text: "Indépendant des fabricants et sans obligation d'exécution : nos recommandations servent votre sécurité, pas la vente d'équipements ou d'agents.",
  },
  {
    title: 'Une expertise reconnue',
    text: "Plus de 20 ans d'expérience, la certification CPP (ASIS International) et des mandats de haut niveau : Stade de Genève, organisations internationales.",
  },
];
---
<Base
  title="DBA Sécurité - Audit, concepts de sûreté & sécurité événementielle"
  description="DBA Sécurité : audit et conseil en sûreté, concepts de sécurité et analyse de risques, sécurité et coordination événementielle, coaching et tests d'intrusion. Du concept à l'exercice grandeur nature."
>
  <!-- HERO -->
  <section class="hero" id="top">
    <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="/assets/video/dba-presentation-poster.jpg">
      <source src="/assets/video/dba-presentation.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <p class="eyebrow">Conseil &amp; expertise en sûreté</p>
      <h1>La sécurité physique, conçue et éprouvée en conditions réelles.</h1>
      <p class="hero-lead">
        Audit, concepts de sûreté, sécurité événementielle, tests d'intrusion et formation.
        Nous concevons vos dispositifs, puis nous les mettons à l'épreuve, pour révéler les
        failles avant qu'elles ne soient exploitées.
      </p>
      <div class="hero-actions">
        <a href="/services" class="btn btn--gold">Découvrir nos services <Icon name="arrow" size={18} /></a>
        <a href="/contact" class="btn btn--ghost-light">Parler à un expert</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--soft" id="services">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Nos services</p>
        <h2>Une gamme complète d'expertises</h2>
        <p class="lead measure mx-auto">
          De l'analyse de risques à la sécurisation de vos événements, nous couvrons l'ensemble
          de la chaîne de la sûreté physique.
        </p>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <a href={s.landing || `/services#${s.slug}`} class="svc-card">
            <span class="svc-img" style={`background-image:url('${s.image}')`}><span class="svc-tag">{s.subtitle}</span></span>
            <span class="svc-body">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <span class="svc-more">En savoir plus <Icon name="arrow" size={15} /></span>
            </span>
          </a>
        ))}
        <a href="/contact" class="svc-card svc-card--cta">
          <span class="svc-body">
            <h3>Un besoin précis&nbsp;?</h3>
            <p>Parlons de votre contexte et des priorités à sécuriser.</p>
            <span class="btn btn--gold">Nous contacter <Icon name="arrow" size={16} /></span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- PARTENAIRE EDGWARD -->
  <PartnerEdgward />

  <!-- DIAGNOSTIC -->
  <section class="diag-band">
    <div class="container diag-inner">
      <div>
        <p class="eyebrow">Auto-évaluation</p>
        <h2>Pas sûr de votre niveau de sûreté&nbsp;?</h2>
        <p class="lead">Évaluez votre événement ou votre site en 2 minutes et recevez des recommandations concrètes, gratuitement.</p>
      </div>
      <a href="/diagnostic-surete" class="btn btn--gold diag-btn">Faire le diagnostic <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- POURQUOI NOUS -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Pourquoi nous choisir</p>
        <h2>Vos atouts avec DBA Sécurité</h2>
      </div>
      <div class="pillars-grid">
        {pillars.map((p, i) => (
          <div class="pillar">
            <span class="pillar-no">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RÉFÉRENCES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Références</p>
        <h2>Ils nous ont fait confiance</h2>
        <p class="lead measure mx-auto">
          Des mandats en Suisse et à l'international, de l'événementiel de prestige aux
          organisations humanitaires.
        </p>
      </div>
      <TrustBar />
      <div class="text-center">
        <a href="/references" class="btn btn--outline">Voir toutes nos références <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- MÉDIAS -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Dans les médias</p>
        <h2>Ils parlent de nous</h2>
        <p class="lead measure mx-auto">
          RTS, Tribune de Genève, 20 minutes, Léman Bleu : notre expertise en sûreté est
          régulièrement sollicitée par les médias.
        </p>
      </div>
      <div class="press-grid">
        {medias.map((m) => (
          <a href={m.url} target="_blank" rel="noopener" class="press-card">
            <span class="press-img" style={`background-image:url('${m.image}')`}>
              <span class="press-type">{m.type}</span>
            </span>
            <span class="press-body">
              <span class="press-meta"><span class="press-out">{m.outlet}</span><span class="press-date">{m.date}</span></span>
              <span class="press-title">{m.title}</span>
              <span class="press-go">Lire / voir <Icon name="arrow" size={14} /></span>
            </span>
          </a>
        ))}
      </div>
      <div class="text-center">
        <a href="/medias" class="btn btn--outline">Voir la revue de presse <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final">
    <div class="container cta-inner">
      <div>
        <h2>Discutons de votre sécurité</h2>
        <p class="lead">Un projet, un événement, un besoin d'expertise ? Notre équipe vous répond et vous accompagne sur l'ensemble de vos enjeux de sécurité physique.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn--gold">Écrire à DBA Sécurité <Icon name="arrow" size={18} /></a>
        <a href="tel:+41228860117" class="btn btn--ghost-light">+41 22 886 0 117</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; min-height: 94vh; display: flex; align-items: center; color: #fff; overflow: hidden; background: var(--navy); }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(8,13,59,.93) 0%, rgba(13,20,90,.74) 42%, rgba(13,20,90,.34) 100%); }
  .hero-inner { position: relative; padding-top: 120px; padding-bottom: 40px; max-width: 760px; }
  .hero .eyebrow { color: var(--gold); }
  .hero h1 { color: #fff; font-size: clamp(2.3rem, 5.4vw, 4rem); margin-bottom: 20px; }
  .hero-lead { font-size: 1.2rem; color: rgba(255,255,255,.9); max-width: 56ch; margin-bottom: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }

  .section-head { margin-bottom: 52px; }
  .section-head h2 { margin-bottom: 14px; }

  /* SERVICES */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .svc-card { display: flex; flex-direction: column; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 14px rgba(13,20,90,.06); color: var(--text); transition: transform .2s ease, box-shadow .2s ease; }
  .svc-card:hover { transform: translateY(-6px); box-shadow: 0 24px 44px rgba(13,20,90,.14); text-decoration: none; }
  .svc-img { display: block; height: 190px; background-size: cover; background-position: center; position: relative; }
  .svc-tag { position: absolute; left: 16px; top: 16px; background: rgba(13,20,90,.92); color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .04em; padding: 6px 12px; border-radius: 30px; }
  .svc-body { display: flex; flex-direction: column; flex: 1; padding: 26px; }
  .svc-body h3 { color: var(--navy); margin-bottom: 9px; }
  .svc-body p { color: var(--text-muted); font-size: 15px; flex: 1; margin-bottom: 18px; }
  .svc-more { display: inline-flex; align-items: center; gap: 7px; color: var(--gold-strong); font-weight: 600; font-size: 15px; }
  .svc-card:hover .svc-more { gap: 11px; transition: gap .2s ease; }
  .svc-card--cta { background: var(--navy); color: #fff; justify-content: center; }
  .svc-card--cta .svc-body { padding: 34px; }
  .svc-card--cta h3 { color: #fff; }
  .svc-card--cta p { color: rgba(255,255,255,.82); }

  /* DIAGNOSTIC */
  .diag-band { background: var(--gradient); color: #fff; }
  .diag-inner { display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap; padding: 56px 0; }
  .diag-inner > div { max-width: 600px; }
  .diag-band .eyebrow { color: var(--gold); }
  .diag-band h2 { color: #fff; margin-bottom: 8px; }
  .diag-band .lead { color: rgba(255,255,255,.85); margin: 0; }
  .diag-btn { flex-shrink: 0; }

  /* POURQUOI */
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .pillar { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 34px 30px; transition: border-color .2s ease, box-shadow .2s ease; }
  .pillar:hover { border-color: transparent; box-shadow: 0 20px 44px rgba(13,20,90,.1); }
  .pillar-no { font-size: 15px; font-weight: 700; color: var(--gold-strong); }
  .pillar h3 { color: var(--navy); margin: 14px 0 10px; }
  .pillar p { color: var(--text-muted); font-size: 15px; margin: 0; }

  /* MÉDIAS */
  .press-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-bottom: 38px; }
  .press-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; color: var(--text); transition: transform .2s ease, box-shadow .2s ease; }
  .press-card:hover { transform: translateY(-5px); box-shadow: 0 22px 40px rgba(13,20,90,.14); text-decoration: none; }
  .press-img { display: block; height: 150px; background-size: cover; background-position: center; position: relative; }
  .press-type { position: absolute; left: 12px; top: 12px; background: rgba(13,20,90,.92); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; padding: 5px 11px; border-radius: 30px; }
  .press-body { display: flex; flex-direction: column; flex: 1; padding: 18px 20px 20px; }
  .press-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 9px; }
  .press-out { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--gold-strong); }
  .press-date { font-size: 12px; color: var(--text-muted); }
  .press-title { font-weight: 600; color: var(--navy); line-height: 1.4; font-size: 15px; flex: 1; }
  .press-go { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-top: 14px; }
  .press-card:hover .press-go { color: var(--gold-strong); }

  /* CTA FINAL */
  .cta-final { background: var(--gradient); color: #fff; padding: 88px 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .cta-inner > div { max-width: 620px; }
  .cta-final h2 { color: #fff; margin-bottom: 12px; }
  .cta-final .lead { color: rgba(255,255,255,.85); margin: 0; }
  .cta-actions { display: flex; gap: 14px; flex-wrap: wrap; }

  @media (max-width: 980px) {
    .svc-grid, .pillars-grid, .press-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .hero { align-items: flex-start; }
    .hero-inner { padding-top: 110px; }
    .hero h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
    .svc-grid, .pillars-grid, .press-grid { grid-template-columns: 1fr; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { medias } from '../data/medias';
import PartnerEdgward from '../components/PartnerEdgward.astro';
import TrustBar from '../components/TrustBar.astro';

const pillars = [
  {
    icon: 'target',
    title: 'Nous concevons et nous éprouvons',
    text: "Nous ne livrons pas qu'un document : nous testons votre dispositif en conditions réelles - exercices grandeur nature, tests d'intrusion - pour révéler les failles avant le jour J.",
  },
  {
    icon: 'shield',
    title: 'Un conseil indépendant',
    text: "Un conseil indépendant des fabricants et sans obligation d'exécution : nos recommandations servent votre sécurité, pas la vente d'équipements ou d'agents.",
  },
  {
    icon: 'spark',
    title: 'Une expertise reconnue',
    text: "Plus de 15 ans d'expérience, la certification CPP (ASIS International) et des mandats de haut niveau : Stade de Genève, organisations internationales.",
  },
];
---
<Base
  title="DBA Sécurité - Audit, concepts de sûreté & sécurité événementielle"
  description="DBA Sécurité : audit et conseil en sûreté, concepts de sécurité et analyse de risques, sécurité et coordination événementielle, coaching et tests d'intrusion. Du concept à l'exercice grandeur nature."
>
  <!-- HERO -->
  <section class="hero section--dark">
    <div class="container hero-grid">
      <div class="hero-inner">
        <p class="eyebrow">DBA Sécurité Sàrl</p>
        <h1>Concevoir votre sûreté,<br />l'éprouver en conditions réelles</h1>
        <p class="lead hero-lead">
          Audit, concepts de sûreté et analyse de risques - puis exercices grandeur
          nature et tests d'intrusion pour révéler les failles avant qu'elles ne
          soient exploitées. En Suisse et à l'international.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn--light">
            Contactez-nous <Icon name="arrow" size={18} />
          </a>
          <a href="/services" class="btn btn--ghost-light">Découvrir nos services</a>
        </div>
      </div>
      <div class="hero-media" aria-hidden="true">
        <video class="hero-video" autoplay muted loop playsinline preload="auto"
          poster="/assets/video/dba-presentation-poster.jpg">
          <source src="/assets/video/dba-presentation.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- SERVICES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Nos services</p>
        <h2>Une gamme complète d’expertises</h2>
        <p class="lead measure mx-auto">
          De l’analyse de risques à la sécurisation de vos événements, nous vous
          accompagnons à chaque étape.
        </p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <a href={`/services#${s.slug}`} class="service-card">
            <span class="service-icon"><Icon name={s.icon} size={26} /></span>
            <h3>{s.title}</h3>
            <p class="service-sub">{s.subtitle}</p>
            <span class="service-more">En savoir plus <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DIAGNOSTIC (CTA) -->
  <section class="section--mist diag-band">
    <div class="container diag-band-inner">
      <div>
        <p class="eyebrow">Auto-évaluation</p>
        <h2>Pas sûr de votre niveau de sûreté ?</h2>
        <p class="lead">Évaluez votre événement ou votre site en 2 minutes et recevez des recommandations concrètes, gratuitement.</p>
      </div>
      <a href="/diagnostic-surete" class="btn btn--gold diag-band-btn">Faire le diagnostic <Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <!-- POURQUOI NOUS -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Pourquoi nous choisir</p>
        <h2>Vos atouts avec DBA Sécurité</h2>
      </div>
      <div class="pillars-grid">
        {pillars.map((p) => (
          <div class="pillar">
            <span class="pillar-icon"><Icon name={p.icon} size={28} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTENAIRE EDGWARD -->
  <PartnerEdgward />

  <!-- RÉFÉRENCES -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Références</p>
        <h2>Ils nous ont fait confiance</h2>
        <p class="lead measure mx-auto">
          Des mandats en Suisse et à l’international, de l’événementiel de prestige
          aux organisations humanitaires.
        </p>
      </div>
      <TrustBar />
      <div class="text-center">
        <a href="/references" class="btn btn--outline">Voir toutes nos références <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- DANS LES MÉDIAS -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Dans les médias</p>
        <h2>Ils parlent de nous</h2>
        <p class="lead measure mx-auto">
          RTS, Tribune de Genève, 20 minutes, Léman Bleu : notre expertise en
          sûreté est régulièrement sollicitée par les médias.
        </p>
      </div>
      <div class="press-strip">
        {medias.map((m) => (
          <a href={m.url} target="_blank" rel="noopener" class="press-item">
            <span class="press-outlet">{m.outlet}</span>
            <span class="press-title">{m.title}</span>
            <span class="press-go">Lire / voir <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
      <div class="text-center">
        <a href="/medias" class="btn btn--outline">Voir la revue de presse <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section--dark cta-final">
    <div class="container text-center">
      <h2>Discutons de votre sécurité</h2>
      <p class="lead measure mx-auto">
        Un projet, un événement, un besoin d’expertise ? Notre équipe vous répond
        et vous accompagne sur l’ensemble de vos enjeux de sécurité physique.
      </p>
      <a href="/contact" class="btn btn--gold">Contactez-nous <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding: 104px 0 96px; }
  .hero-grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: center;
  }
  .hero-inner { max-width: 640px; }
  .hero h1 { margin-bottom: 20px; }
  .hero-lead { max-width: 620px; margin-bottom: 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-media { display: flex; justify-content: center; }
  .hero-video {
    width: 380px;
    height: 480px;
    object-fit: cover;
    object-position: center;
    opacity: 0.95;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 74% 68% at 50% 50%, #000 50%, transparent 100%);
    mask-image: radial-gradient(ellipse 74% 68% at 50% 50%, #000 50%, transparent 100%);
  }
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(214, 218, 255, 0.22), transparent 65%);
    z-index: 1;
  }

  /* INTRO */
  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  .intro-text p { font-size: 1.05rem; }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    margin-top: 8px;
  }
  .link-arrow:hover { text-decoration: none; gap: 11px; transition: gap 0.2s ease; }

  .section-head { margin-bottom: 48px; }
  .section-head h2 { margin-bottom: 14px; }

  /* SERVICES */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
    text-decoration: none;
  }
  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--mist);
    color: var(--brand);
    margin-bottom: 18px;
  }
  .service-card h3 { margin-bottom: 4px; }
  .service-sub { color: var(--text-muted); font-size: 0.95rem; flex-grow: 1; }
  .service-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand);
    font-weight: 600;
    font-size: 14px;
    margin-top: 16px;
  }

  /* PILIERS */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .pillar { text-align: center; padding: 0 12px; }
  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--gradient);
    color: #fff;
    margin-bottom: 20px;
  }
  .pillar p { color: var(--text-muted); }

  /* RÉFÉRENCES */
  .refs-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .ref-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 24px;
    min-width: 180px;
    box-shadow: var(--shadow-sm);
  }
  .ref-name { font-weight: 700; color: var(--navy); font-size: 1.05rem; }
  .ref-tag { font-size: 0.82rem; color: var(--text-muted); }

  /* PRESSE */
  .press-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }
  .press-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: #fff;
    color: var(--text);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .press-item:hover { transform: translateY(-3px); box-shadow: var(--shadow); text-decoration: none; }
  .press-outlet { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold-strong); }
  .press-title { font-weight: 600; color: var(--navy); line-height: 1.4; }
  .press-go { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--brand); margin-top: 2px; }

  /* DIAGNOSTIC BAND */
  .diag-band { padding: 56px 0; }
  .diag-band-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .diag-band-inner > div { max-width: 620px; }
  .diag-band-inner h2 { margin-bottom: 10px; }
  .diag-band-inner .lead { margin-bottom: 0; }
  .diag-band-btn { flex-shrink: 0; }

  /* CTA */
  .cta-final { padding: 84px 0; }
  .cta-final .lead { margin-bottom: 28px; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 24px; }
    .hero-media { justify-content: flex-start; }
    .hero-video { width: 300px; height: 380px; }
    .intro-grid { grid-template-columns: 1fr; gap: 20px; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    .pillars-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 560px) {
    .services-grid { grid-template-columns: 1fr; }
    .press-strip { grid-template-columns: 1fr; }
    .hero { padding: 88px 0 76px; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { references } from '../data/references';

const pillars = [
  {
    icon: 'shield',
    title: 'Expertise en sécurité',
    text: "Une équipe d’experts chevronnés en sécurité physique, dotés d’une expérience approfondie du terrain.",
  },
  {
    icon: 'users',
    title: 'Approche personnalisée',
    text: "Des solutions adaptées aux besoins spécifiques de chaque client, en tenant compte de ses contraintes et objectifs.",
  },
  {
    icon: 'spark',
    title: 'Innovation continue',
    text: "Une veille permanente sur les dernières tendances et technologies pour une protection efficace et fiable.",
  },
];
---
<Base>
  <!-- HERO -->
  <section class="hero section--dark">
    <div class="container hero-inner">
      <p class="eyebrow">DBA Sécurité Sàrl</p>
      <h1>Une expertise sécurité<br />à votre service</h1>
      <p class="lead hero-lead">
        Consulting, audits et expertise dans la sécurité physique des
        infrastructures, des biens et des personnes - en Suisse et à l’international.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn--light">
          Contactez-nous <Icon name="arrow" size={18} />
        </a>
        <a href="/services" class="btn btn--ghost-light">Découvrir nos services</a>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- PRÉSENTATION -->
  <section class="section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Qui sommes-nous</p>
        <h2>{site.name}</h2>
      </div>
      <div class="intro-text">
        <p>
          DBA Sécurité propose ses services de consulting, d’audits et d’expertise
          dans le domaine de la sécurité physique des infrastructures, des biens et
          des personnes.
        </p>
        <p>
          Fondée sur des valeurs d’<strong>intégrité</strong>, d’<strong>engagement</strong>
          et d’<strong>innovation</strong>, notre entreprise s’engage à fournir des
          solutions de sécurité personnalisées et efficaces, pour répondre aux
          besoins uniques de chaque client.
        </p>
        <a href="/a-propos" class="link-arrow">En savoir plus sur DBA Sécurité <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Nos services</p>
        <h2>Une gamme complète d’expertises</h2>
        <p class="lead measure mx-auto">
          De l’analyse de risques à la sécurisation de vos événements, nous vous
          accompagnons à chaque étape.
        </p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <a href={`/services#${s.slug}`} class="service-card">
            <span class="service-icon"><Icon name={s.icon} size={26} /></span>
            <h3>{s.title}</h3>
            <p class="service-sub">{s.subtitle}</p>
            <span class="service-more">En savoir plus <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- POURQUOI NOUS -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Pourquoi nous choisir</p>
        <h2>Vos atouts avec DBA Sécurité</h2>
      </div>
      <div class="pillars-grid">
        {pillars.map((p) => (
          <div class="pillar">
            <span class="pillar-icon"><Icon name={p.icon} size={28} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RÉFÉRENCES -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head text-center">
        <p class="eyebrow">Références</p>
        <h2>Ils nous ont fait confiance</h2>
        <p class="lead measure mx-auto">
          Des mandats en Suisse et à l’international, de l’événementiel de prestige
          aux organisations humanitaires.
        </p>
      </div>
      <div class="refs-grid">
        {references.slice(0, 5).map((r) => (
          <div class="ref-chip">
            <span class="ref-name">{r.name}</span>
            <span class="ref-tag">{r.tag}</span>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="/references" class="btn btn--outline">Voir toutes nos références <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section--dark cta-final">
    <div class="container text-center">
      <h2>Discutons de votre sécurité</h2>
      <p class="lead measure mx-auto">
        Un projet, un événement, un besoin d’expertise ? Notre équipe vous répond
        et vous accompagne sur l’ensemble de vos enjeux de sécurité physique.
      </p>
      <a href="/contact" class="btn btn--gold">Contactez-nous <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding: 120px 0 108px; }
  .hero-inner { position: relative; z-index: 2; max-width: 780px; }
  .hero h1 { margin-bottom: 20px; }
  .hero-lead { max-width: 620px; margin-bottom: 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(214, 218, 255, 0.22), transparent 65%);
    z-index: 1;
  }

  /* INTRO */
  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  .intro-text p { font-size: 1.05rem; }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    margin-top: 8px;
  }
  .link-arrow:hover { text-decoration: none; gap: 11px; transition: gap 0.2s ease; }

  .section-head { margin-bottom: 48px; }
  .section-head h2 { margin-bottom: 14px; }

  /* SERVICES */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
    text-decoration: none;
  }
  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--mist);
    color: var(--brand);
    margin-bottom: 18px;
  }
  .service-card h3 { margin-bottom: 4px; }
  .service-sub { color: var(--text-muted); font-size: 0.95rem; flex-grow: 1; }
  .service-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand);
    font-weight: 600;
    font-size: 14px;
    margin-top: 16px;
  }

  /* PILIERS */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .pillar { text-align: center; padding: 0 12px; }
  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--gradient);
    color: #fff;
    margin-bottom: 20px;
  }
  .pillar p { color: var(--text-muted); }

  /* RÉFÉRENCES */
  .refs-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .ref-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 24px;
    min-width: 180px;
    box-shadow: var(--shadow-sm);
  }
  .ref-name { font-weight: 700; color: var(--navy); font-size: 1.05rem; }
  .ref-tag { font-size: 0.82rem; color: var(--text-muted); }

  /* CTA */
  .cta-final { padding: 84px 0; }
  .cta-final .lead { margin-bottom: 28px; }

  @media (max-width: 860px) {
    .intro-grid { grid-template-columns: 1fr; gap: 20px; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    .pillars-grid { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 560px) {
    .services-grid { grid-template-columns: 1fr; }
    .hero { padding: 88px 0 76px; }
  }
</style>

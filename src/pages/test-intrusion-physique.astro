---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const etapes = [
  {
    icon: 'target',
    title: 'Cadrage & objectifs',
    text: "Nous définissons avec vous le périmètre, les scénarios de menace réalistes et les règles d'engagement : ce qui est testé, ce qui ne l'est pas, et les garde-fous de sécurité.",
  },
  {
    icon: 'eye',
    title: 'Scénarisation',
    text: "Nous construisons des scénarios crédibles à partir de votre contexte réel : talonnage, badge prêté, livraison détournée, zone de service oubliée - ce qu'un acteur malveillant tenterait vraiment.",
  },
  {
    icon: 'shield',
    title: 'Exécution en conditions réelles',
    text: "Nos intervenants éprouvent le dispositif sur le terrain, discrètement et en sécurité, pour mesurer ce que vos mesures techniques, humaines et organisationnelles permettent réellement d'arrêter.",
  },
  {
    icon: 'spark',
    title: 'Restitution & plan d’action',
    text: "Vous recevez un rapport clair : les failles exploitées, hiérarchisées par gravité, et des recommandations concrètes - organisationnelles autant que techniques - pour corriger ce qui compte.",
  },
];

const livrables = [
  'Rapport de test détaillé et confidentiel',
  'Failles hiérarchisées par gravité et par effort de correction',
  'Recommandations concrètes et actionnables',
  'Restitution orale à la direction',
  'Points de contrôle pour vérifier la correction',
];

const faqs = [
  {
    q: "Est-ce la même chose qu'un test d'intrusion informatique (pentest) ?",
    a: "Non. Un pentest informatique cible des systèmes et des réseaux. Un test d'intrusion physique éprouve l'accès réel à vos locaux et à vos zones sensibles : contrôle d'accès, badges, talonnage, réaction des agents, procédures. Les deux sont complémentaires, mais ce sont deux métiers distincts.",
  },
  {
    q: "Est-ce légal et sans risque ?",
    a: "Oui, dès lors que le test est encadré. Il repose sur un mandat écrit, un périmètre défini, des règles d'engagement et des garde-fous de sécurité convenus à l'avance. Rien n'est laissé au hasard : l'objectif est de révéler les failles, pas de créer un incident.",
  },
  {
    q: "Faut-il prévenir les équipes ?",
    a: "Cela dépend de l'objectif. Un test à l'insu des équipes mesure leur réaction réelle ; un test annoncé valide des procédures précises. Nous en décidons ensemble lors du cadrage, en veillant toujours au respect des personnes.",
  },
  {
    q: "Et un exercice grandeur nature, est-ce différent ?",
    a: "Oui. Le test d'intrusion éprouve la résistance d'un site ; l'exercice grandeur nature met à l'épreuve la coordination de tous les acteurs (sécurité privée, police, secours) face à un scénario majeur. Nous réalisons les deux, selon vos enjeux.",
  },
];

const related = [
  { label: "Test d'intrusion physique : comment on éprouve un site", slug: 'test-intrusion-physique' },
  { label: "Exercice grandeur nature : les leçons des 400 intervenants au Stade de Genève", slug: 'exercice-grandeur-nature-stade-de-geneve' },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: "Test d'intrusion physique et exercices grandeur nature",
  serviceType: "Test d'intrusion physique (red team), exercice de sécurité grandeur nature",
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['Genève', 'Suisse romande', 'Suisse'],
  description:
    "DBA Sécurité réalise des tests d'intrusion physique (red team) et des exercices grandeur nature pour éprouver la robustesse réelle d'un site, d'un dispositif et de ses équipes.",
  url: new URL('/test-intrusion-physique', site.url).href,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Test d'intrusion physique en Suisse - DBA Sécurité"
  description="Test d'intrusion physique (red team) et exercices grandeur nature : DBA Sécurité éprouve la robustesse réelle de votre site et de vos équipes. Cadre, déroulé et livrables."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <PageHero
    eyebrow="Tests & exercices"
    title="Test d'intrusion physique & exercices grandeur nature"
    subtitle="Concevoir un dispositif ne suffit pas : il faut l'éprouver. Nous testons la résistance réelle de votre site et la coordination de vos équipes - pour révéler les failles avant qu'elles ne soient exploitées."
  />

  <!-- ENJEU -->
  <section class="section">
    <div class="container enjeu">
      <p class="eyebrow">L'enjeu</p>
      <h2>Un dispositif ne vaut que ce qu'il donne le jour où il est attaqué</h2>
      <p class="lead">
        Caméras, badges, procédures, agents : sur le papier, tout semble en place. La vraie question est ailleurs -
        que se passe-t-il quand quelqu'un tente réellement d'entrer ? Un test d'intrusion physique répond à cette
        question avec des faits, pas des suppositions. Il révèle l'écart entre le dispositif prévu et sa robustesse réelle.
      </p>
    </div>
  </section>

  <!-- METHODE -->
  <section class="section section--soft">
    <div class="container">
      <SectionHeader eyebrow="Notre approche" title="Comment nous éprouvons votre sécurité" center />
      <div class="steps-grid">
        {etapes.map((e, i) => (
          <div class="step-card">
            <span class="step-num">{i + 1}</span>
            <span class="step-icon"><Icon name={e.icon} size={24} /></span>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LIVRABLES -->
  <section class="section">
    <div class="container livrables-grid">
      <div>
        <p class="eyebrow">Ce que vous recevez</p>
        <h2>Un rapport qui sert à décider</h2>
        <p class="lead">
          Un test d'intrusion ne s'arrête pas au constat. Nous relions chaque faille à ce qu'elle permettrait
          concrètement, puis nous priorisons - pour que vous sachiez quoi corriger en premier, et comment.
        </p>
      </div>
      <ul class="livrables-list">
        {livrables.map((l) => (
          <li><Icon name="check" size={18} /> <span>{l}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PREUVE -->
  <section class="section section--dark proof">
    <div class="container proof-inner">
      <div>
        <p class="eyebrow">En conditions réelles</p>
        <h2>Un exercice grandeur nature de près de 400 intervenants</h2>
        <p class="lead">
          Avant le Championnat d'Europe féminin 2025, DBA Sécurité a piloté au Stade de Genève un exercice de
          simulation mobilisant police, secours et sécurité privée, pour éprouver la coordination des acteurs et
          les protocoles d'intervention avant la compétition. Éprouver un dispositif avant l'événement, c'est
          précisément notre métier.
        </p>
        <div class="proof-actions">
          <a href="/references" class="btn btn--light">Voir nos références <Icon name="arrow" size={16} /></a>
          <a href="/medias" class="btn btn--ghost-light">Couverture presse</a>
        </div>
      </div>
      <div class="proof-stats">
        <div class="pstat"><span class="pstat-num">~400</span><span class="pstat-label">intervenants coordonnés</span></div>
        <div class="pstat"><span class="pstat-num">Police · secours · privé</span><span class="pstat-label">acteurs mobilisés</span></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-wrap">
      <SectionHeader eyebrow="Questions fréquentes" title="Ce qu'il faut savoir avant un test" center />
      {faqs.map((f) => (
        <details class="faq-item">
          <summary><span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="faq-answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  <!-- POUR ALLER PLUS LOIN -->
  <section class="section section--soft">
    <div class="container related-wrap">
      <p class="eyebrow">Pour aller plus loin</p>
      <h2>Nos analyses sur le sujet</h2>
      <ul class="related-list">
        {related.map((r) => (
          <li><a href={`/blog/${r.slug}`}><Icon name="arrow" size={16} /> {r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCTA
    title="Prêt à éprouver votre dispositif ?"
    text="Parlons de votre site, de vos enjeux et du scénario le plus utile à tester."
  />
</Base>

<style>
  .enjeu { max-width: 820px; }
  .enjeu h2 { margin-bottom: 16px; }

  .steps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .step-card {
    position: relative; background: #fff; border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 30px 28px;
  }
  .step-num {
    position: absolute; top: 24px; right: 26px;
    font-size: 2.2rem; font-weight: 700; color: var(--mist); line-height: 1;
  }
  .step-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 13px;
    background: var(--mist); color: var(--brand); margin-bottom: 16px;
  }
  .step-card h3 { margin-bottom: 8px; }
  .step-card p { color: var(--text-muted); margin: 0; }

  .livrables-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .livrables-grid h2 { margin-bottom: 14px; }
  .livrables-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .livrables-list li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; color: var(--navy); }
  .livrables-list svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 3px; }

  .proof-inner { display: grid; grid-template-columns: 1.5fr 1fr; gap: 44px; align-items: center; }
  .proof-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .proof-stats { display: flex; flex-direction: column; gap: 22px; }
  .pstat { display: flex; flex-direction: column; border-left: 3px solid var(--gold); padding-left: 18px; }
  .pstat-num { font-size: 1.8rem; font-weight: 700; color: #fff; line-height: 1.1; }
  .pstat-label { font-size: 0.9rem; color: var(--gold); margin-top: 6px; }

  .faq-wrap { max-width: 820px; }
  .faq-item { border: 1px solid var(--border); border-radius: var(--radius-lg); background: #fff; overflow: hidden; margin-bottom: 12px; }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 22px 24px; cursor: pointer; font-weight: 600; color: var(--navy); font-size: 1.05rem; list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; width: 18px; height: 18px; flex-shrink: 0; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; background: var(--gold-strong); border-radius: 2px; transition: transform 0.2s ease; }
  .faq-plus::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq-plus::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-answer { padding: 0 24px 22px; }
  .faq-answer p { color: var(--text-muted); margin: 0; line-height: 1.7; }

  .related-wrap { max-width: 820px; }
  .related-wrap h2 { margin-bottom: 20px; }
  .related-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .related-list a { display: inline-flex; align-items: baseline; gap: 10px; color: var(--navy); font-weight: 600; font-size: 1.05rem; }
  .related-list a:hover { color: var(--brand); }
  .related-list svg { color: var(--gold-strong); flex-shrink: 0; transform: translateY(2px); }

  @media (max-width: 820px) {
    .steps-grid { grid-template-columns: 1fr; }
    .livrables-grid { grid-template-columns: 1fr; gap: 28px; }
    .proof-inner { grid-template-columns: 1fr; gap: 28px; }
    .proof-stats { flex-direction: row; flex-wrap: wrap; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const domaines = [
  { icon: 'calendar', title: 'Sûreté des grands événements', text: "Conception et coordination de dispositifs pour événements sportifs, culturels et de prestige." },
  { icon: 'target', title: 'Gestion de crise & menace', text: "Anticipation des scénarios, plans d'intervention et préparation face aux menaces actuelles." },
  { icon: 'shield', title: 'Concepts & audits de sûreté', text: "Analyse de risques et élaboration de concepts de protection sur mesure." },
  { icon: 'graduation', title: 'Formation & exercices', text: "Montée en compétence des équipes et exercices grandeur nature en conditions réelles." },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Daniel Barouch',
  jobTitle: 'Fondateur et gérant, expert en sûreté et sécurité physique',
  worksFor: { '@type': 'Organization', name: site.name, url: site.url },
  url: new URL('/fondateur', site.url).href,
  image: new URL('/assets/photos/portrait-daniel-barouch.jpg', site.url).href,
  sameAs: [site.linkedin],
  knowsAbout: ['sûreté physique', 'sécurité événementielle', 'analyse de risques', 'concept de sûreté', 'gestion de crise', "tests d'intrusion"],
  description: "Fondateur de DBA Sécurité, responsable sécurité du Stade de Genève pour le Championnat d'Europe féminin de football 2025, Certified Protection Professional (CPP, ASIS International).",
};
---
<Base title={`Daniel Barouch - Expert en sûreté physique`} description="Daniel Barouch, fondateur de DBA Sécurité : expert en sûreté événementielle, gestion de crise et concepts de sécurité physique.">
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  <PageHero
    eyebrow="Le fondateur"
    title="Daniel Barouch"
    subtitle="Expert en sûreté et sécurité physique, spécialiste de la protection des grands événements et de la gestion de crise."
  />

  <section class="section">
    <div class="container expert-grid">
      <div class="expert-photo">
        <img src="/assets/photos/portrait-daniel-barouch.jpg" alt="Daniel Barouch, fondateur de DBA Sécurité" class="expert-portrait" width="900" height="1072" />
        <a href={site.linkedin} target="_blank" rel="noopener" class="expert-linkedin">
          <Icon name="linkedin" size={18} /> Profil LinkedIn
        </a>
      </div>
      <div class="expert-bio">
        <p class="lead">Fondateur de DBA Sécurité, Daniel Barouch met plus de vingt ans d'expérience de la sûreté physique au service de ses clients - du terrain à la direction de grands dispositifs, en Suisse et à l'international.</p>
        <p>Pendant plus de six ans, il a dirigé un département opérationnel d'une grande société de sécurité privée en Suisse, conduisant jusqu'à 500 à 600 collaborateurs et pilotant des mandats sensibles et stratégiques : engagements diplomatiques internationaux, organisations internationales et institutions, en coordination étroite avec les autorités.</p>
        <p>Auparavant responsable de la sécurité physique d'une organisation internationale de premier plan, il a sécurisé des sites sensibles et des visites officielles - chefs d'État, ministres et personnalités sous protection - lors d'événements en Suisse et à l'étranger, et conçu les concepts de gestion de crise et d'évacuation lors d'événements diplomatiques et économiques de haut niveau.</p>
        <p>Entrepreneur, il a fondé et dirigé plusieurs sociétés de sécurité et assuré sur le terrain la sûreté de centaines d'événements festifs, culturels et sportifs. Aujourd'hui à la tête de DBA Sécurité, il est notamment intervenu comme responsable sécurité du Stade de Genève et consultant sécurité pour le Canton de Genève pour le Championnat d'Europe féminin 2025, en pilotant un exercice grandeur nature de près de 400 intervenants. Régulièrement sollicité par les médias, il partage son analyse sur les méthodes d'intervention et l'évolution des menaces.</p>

        <div class="cred">
          <h3>Formations &amp; certifications</h3>
          <ul>
            <li><Icon name="check" size={18} /><span>BA, MA (Université de Genève) et MsBA (HES-SO).</span></li>
            <li><Icon name="check" size={18} /><span>Certified Protection Professional® (CPP) - ASIS International, la plus haute certification internationale en management de la sécurité.</span></li>
            <li><Icon name="check" size={18} /><span>CAS en communication de crise (ZHAW).</span></li>
            <li><Icon name="check" size={18} /><span>Juge militaire dans l'armée suisse.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHeader eyebrow="Domaines d'expertise" title="Une spécialisation en sûreté physique" center />
      <div class="domaines-grid">
        {domaines.map((d) => (
          <div class="domaine-card">
            <span class="domaine-icon"><Icon name={d.icon} size={24} /></span>
            <div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container media-teaser">
      <div>
        <p class="eyebrow">Dans les médias</p>
        <h2>Une expertise reconnue</h2>
        <p class="lead">RTS, Tribune de Genève, 20 minutes, Léman Bleu… Daniel Barouch et DBA Sécurité sont régulièrement sollicités sur les questions de sûreté.</p>
      </div>
      <a href="/medias" class="btn btn--outline">Voir la revue de presse <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <FinalCTA title="Un projet à sécuriser ?" text="Échangeons sur vos enjeux de sûreté et de sécurité physique." />
</Base>

<style>
  .expert-grid { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: start; }
  .expert-photo { position: sticky; top: 96px; }
  .expert-portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .expert-linkedin { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; font-weight: 600; font-size: 14px; }
  .expert-bio .lead { color: var(--text); }
  .expert-bio p { text-align: justify; }
  .editor-note {
    margin-top: 22px; padding: 16px 18px;
    border: 1.5px dashed var(--gold); border-radius: var(--radius);
    background: rgba(201, 162, 75, 0.07); font-size: 14px; color: var(--text-muted);
  }
  .editor-note strong { color: var(--gold-strong); }
  .cred { margin-top: 26px; padding: 22px 24px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--soft); }
  .cred h3 { font-size: 1rem; margin-bottom: 14px; }
  .cred ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .cred li { display: flex; gap: 11px; align-items: flex-start; font-size: 0.95rem; color: var(--text); line-height: 1.5; }
  .cred li svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 3px; }

  .domaines-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .domaine-card { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .domaine-icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: var(--mist); color: var(--brand); flex-shrink: 0; }
  .domaine-card h3 { margin-bottom: 4px; }
  .domaine-card p { color: var(--text-muted); margin: 0; }

  .media-teaser { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .media-teaser > div { max-width: 640px; }

  @media (max-width: 820px) {
    .expert-grid { grid-template-columns: 1fr; gap: 28px; }
    .expert-photo { position: static; max-width: 280px; }
    .domaines-grid { grid-template-columns: 1fr; }
  }
</style>

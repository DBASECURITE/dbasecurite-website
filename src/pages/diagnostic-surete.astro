---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { branches, recommendations, levels } from '../data/diagnostic';

const payload = JSON.stringify({ branches, recommendations, levels });
---
<Base
  title={`Auto-évaluation de sûreté - ${site.name}`}
  description="Évaluez en 2 minutes le niveau de sûreté de votre événement ou de votre site. Diagnostic honnête et recommandations concrètes, gratuit et sans engagement."
>
  <PageHero
    eyebrow="Auto-évaluation"
    title="Évaluez votre niveau de sûreté"
    subtitle="En 2 minutes, obtenez un diagnostic honnête de votre dispositif et des recommandations concrètes. Gratuit et sans engagement."
  />

  <section class="section">
    <div class="container">
      <div class="diag" id="diag-app" aria-live="polite"></div>
    </div>
  </section>

  <script type="application/json" id="diag-data" set:html={payload}></script>

  <script>
    const data = JSON.parse(document.getElementById('diag-data').textContent);
    const app = document.getElementById('diag-app');
    const ICONS = {
      calendar: '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>',
      shield: '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/></svg>',
      check: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
      arrow: '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
    };

    let state = { branch: null, answers: [], idx: 0 };

    function renderStart() {
      state = { branch: null, answers: [], idx: 0 };
      app.innerHTML = `
        <div class="diag-card diag-start">
          <h2>Que souhaitez-vous évaluer ?</h2>
          <div class="diag-branches">
            ${data.branches.map((b) => `
              <button class="diag-branch" data-branch="${b.key}">
                <span class="diag-branch-ico">${ICONS[b.icon] || ''}</span>
                <span class="diag-branch-label">${b.label}</span>
                <span class="diag-branch-tag">${b.tagline}</span>
              </button>`).join('')}
          </div>
          <p class="diag-note">Vos réponses restent sur votre appareil. Rien n'est envoyé sans votre accord.</p>
        </div>`;
    }

    function renderQuiz() {
      const b = data.branches.find((x) => x.key === state.branch);
      const q = b.questions[state.idx];
      const total = b.questions.length;
      app.innerHTML = `
        <div class="diag-card">
          <div class="diag-progress"><span style="width:${(state.idx / total) * 100}%"></span></div>
          <p class="diag-step">Question ${state.idx + 1} / ${total}</p>
          <h2 class="diag-q">${q.question}</h2>
          <div class="diag-options">
            ${q.options.map((o) => `<button class="diag-opt" data-score="${o.score}" data-pillar="${q.pillar}">${o.label}</button>`).join('')}
          </div>
          <button class="diag-back" data-back>← Retour</button>
        </div>`;
    }

    function renderResult() {
      const b = data.branches.find((x) => x.key === state.branch);
      const total = state.answers.reduce((s, a) => s + a.score, 0);
      const max = b.questions.length * 2;
      const pct = max ? total / max : 0;
      const level = data.levels.find((l) => pct >= l.min) || data.levels[data.levels.length - 1];
      const weak = [];
      state.answers.forEach((a) => { if (a.score <= 1 && !weak.includes(a.pillar)) weak.push(a.pillar); });
      const recos = weak.map((p) => data.recommendations[p]).filter(Boolean).slice(0, 3);

      // Transmet le résumé du diagnostic au formulaire de contact (message pré-rempli + sujet).
      const sujetDiag = { evenement: 'Sécurité événementielle', site: 'Audit / concept de sûreté' }[state.branch] || '';
      const msgDiag = `Bonjour,\n\nJ'ai réalisé le diagnostic de sûreté en ligne (${b.label}).\nRésultat : ${level.title} (${Math.round(pct * 100)}%).`
        + (recos.length ? `\nPoints de vigilance : ${recos.join(' / ')}.` : '')
        + `\n\nJ'aimerais en discuter avec un expert.`;
      const contactHref = `/contact?sujet=${encodeURIComponent(sujetDiag)}&diag=${encodeURIComponent(msgDiag)}`;

      app.innerHTML = `
        <div class="diag-card diag-result lvl-${level.key}">
          <p class="diag-step">Votre résultat</p>
          <div class="diag-head">
            <div class="diag-gauge" style="--pct:${Math.round(pct * 100)}"><span>${Math.round(pct * 100)}%</span></div>
            <div>
              <span class="diag-level">${level.title}</span>
              <p class="diag-leveltext">${level.text}</p>
            </div>
          </div>
          ${recos.length ? `
            <div class="diag-recos">
              <h3>Vos points de vigilance prioritaires</h3>
              <ul>${recos.map((r) => `<li>${ICONS.check}<span>${r}</span></li>`).join('')}</ul>
            </div>` : `
            <p class="diag-norec">${ICONS.check} Aucun point critique détecté. Un œil expert vous aidera à maintenir ce niveau.</p>`}
          <div class="diag-cta">
            <a href="${contactHref}" class="btn btn--gold">Discutez-en avec un expert ${ICONS.arrow}</a>
            <button class="diag-restart" data-restart>Recommencer</button>
          </div>
        </div>`;
    }

    app.addEventListener('click', (e) => {
      const branchBtn = e.target.closest('[data-branch]');
      const opt = e.target.closest('.diag-opt');
      const back = e.target.closest('[data-back]');
      const restart = e.target.closest('[data-restart]');
      if (branchBtn) { state.branch = branchBtn.dataset.branch; state.answers = []; state.idx = 0; renderQuiz(); }
      else if (opt) {
        state.answers[state.idx] = { pillar: opt.dataset.pillar, score: Number(opt.dataset.score) };
        const b = data.branches.find((x) => x.key === state.branch);
        state.idx++;
        if (state.idx >= b.questions.length) renderResult(); else renderQuiz();
      } else if (back) {
        state.idx--;
        if (state.idx < 0) renderStart(); else renderQuiz();
      } else if (restart) { renderStart(); }
    });

    // Lien direct possible : /diagnostic-surete?type=evenement ou ?type=site
    const _t = new URLSearchParams(location.search).get('type');
    if (_t === 'evenement' || _t === 'site') { state.branch = _t; state.answers = []; state.idx = 0; renderQuiz(); }
    else renderStart();
  </script>

  <style is:global>
    .diag { max-width: 720px; margin: 0 auto; }
    .diag-card {
      background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
      padding: 40px; box-shadow: var(--shadow);
    }
    .diag-start h2, .diag-q { font-size: 1.5rem; margin-bottom: 24px; }
    .diag-branches { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .diag-branch {
      display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
      text-align: left; padding: 24px; border: 1px solid var(--border); border-radius: var(--radius-lg);
      background: var(--soft); cursor: pointer; transition: all 0.18s ease; font-family: inherit;
    }
    .diag-branch:hover { border-color: var(--brand); background: #fff; transform: translateY(-3px); box-shadow: var(--shadow); }
    .diag-branch-ico { color: var(--brand); display: inline-flex; }
    .diag-branch-label { font-weight: 700; color: var(--navy); font-size: 1.1rem; }
    .diag-branch-tag { font-size: 0.85rem; color: var(--text-muted); }
    .diag-note { font-size: 0.82rem; color: var(--text-muted); margin: 20px 0 0; }

    .diag-progress { height: 6px; background: var(--border); border-radius: 6px; overflow: hidden; margin-bottom: 20px; }
    .diag-progress span { display: block; height: 100%; background: var(--gold); transition: width 0.3s ease; }
    .diag-step { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold-strong); margin: 0 0 10px; }
    .diag-options { display: flex; flex-direction: column; gap: 12px; }
    .diag-opt {
      text-align: left; padding: 16px 20px; border: 1px solid var(--border); border-radius: var(--radius);
      background: #fff; cursor: pointer; font-size: 1rem; font-weight: 500; color: var(--text); font-family: inherit;
      transition: all 0.15s ease;
    }
    .diag-opt:hover { border-color: var(--brand); background: var(--mist); transform: translateX(4px); }
    .diag-back { margin-top: 22px; background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.9rem; font-family: inherit; padding: 4px; }
    .diag-back:hover { color: var(--brand); }

    .diag-head { display: flex; align-items: center; gap: 24px; margin-bottom: 26px; }
    .diag-gauge {
      flex-shrink: 0; width: 108px; height: 108px; border-radius: 50%;
      background: conic-gradient(var(--gold) calc(var(--pct) * 1%), var(--border) 0);
      display: flex; align-items: center; justify-content: center;
    }
    .diag-gauge span {
      width: 82px; height: 82px; border-radius: 50%; background: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 1.3rem; color: var(--navy);
    }
    .diag-level { font-size: 1.35rem; font-weight: 700; color: var(--navy); display: block; }
    .diag-leveltext { color: var(--text-muted); margin: 6px 0 0; }
    .diag-recos { border-top: 1px solid var(--border); padding-top: 22px; }
    .diag-recos h3 { font-size: 1.05rem; margin-bottom: 14px; }
    .diag-recos ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
    .diag-recos li { display: flex; gap: 12px; align-items: flex-start; color: var(--text); }
    .diag-recos li svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 2px; }
    .diag-norec { display: flex; gap: 10px; align-items: center; color: var(--text); border-top: 1px solid var(--border); padding-top: 22px; }
    .diag-norec svg { color: var(--gold-strong); flex-shrink: 0; }

    .diag-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 26px; }
    .diag-restart { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.9rem; font-family: inherit; text-decoration: underline; }
    .diag-restart:hover { color: var(--brand); }

    @media (max-width: 600px) {
      .diag-card { padding: 28px 22px; }
      .diag-branches { grid-template-columns: 1fr; }
      .diag-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    }
  </style>
</Base>

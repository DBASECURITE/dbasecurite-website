---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d: Date) => d.toLocaleDateString('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' });

// Couverture par article (photos DBA). Modifiable librement.
const covers: Record<string, string> = {
  'surete-ou-securite': '/assets/photos/expertise-evenement.jpg',
  'concept-de-surete': '/assets/photos/services-audit.jpg',
  'analyse-de-risques-surete': '/assets/photos/gestion-foule-international.jpg',
  'audit-de-surete-site': '/assets/photos/scrasa-chantier.jpg',
  'defense-en-profondeur-securite-physique': '/assets/photos/securite-evenementielle-wef.jpg',
  'appel-offres-securite-cahier-des-charges': '/assets/photos/services-specialises-wef.jpg',
  'concept-securite-manifestation': '/assets/photos/manifestation-geneve.jpg',
  'coordination-securite-evenement': '/assets/photos/services-coordination.jpg',
  'exercice-grandeur-nature-stade-de-geneve': '/assets/photos/stade-geneve-briefing.jpg',
  'test-intrusion-physique': '/assets/photos/manifestation-vaud.jpg',
  'gestion-de-crise-direction': '/assets/photos/formation-page.jpg',
  'sensibilisation-surete-collaborateurs': '/assets/photos/expertise-defile.jpg',
};
const cover = (id: string) => (covers[id] ?? '/assets/photos/stade-geneve-briefing.jpg');

const featured = posts[0];
const rest = posts.slice(1);
---
<Base title={`Blog & analyses - ${site.name}`} description="Analyses d'expert en sûreté et sécurité physique : concepts, gestion de crise, sécurité événementielle.">
  <PageHero
    eyebrow="Blog & analyses"
    title="Regards d'expert sur la sûreté"
    subtitle="Nos analyses sur les concepts de sécurité, la gestion de crise et la protection des grands événements."
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <Icon name="file" size={40} />
          <h2>Premiers articles à venir</h2>
          <p>Nos analyses seront publiées ici prochainement.</p>
        </div>
      ) : (
        <>
          {featured && (
            <a href={`/blog/${featured.id}`} class="feat">
              <span class="feat-img" style={`background-image:url('${cover(featured.id)}')`}></span>
              <span class="feat-body">
                <span class="feat-meta">
                  {featured.data.category && <span class="cat">{featured.data.category}</span>}
                  <span class="feat-latest">Dernier article</span>
                </span>
                <h2>{featured.data.title}</h2>
                <p class="feat-desc">{featured.data.description}</p>
                <span class="feat-foot">
                  <span class="date">{fmt(featured.data.date)}</span>
                  <span class="read">Lire l'article <Icon name="arrow" size={16} /></span>
                </span>
              </span>
            </a>
          )}

          <div class="blog-grid">
            {rest.map((p) => (
              <a href={`/blog/${p.id}`} class="post-card">
                <span class="post-img" style={`background-image:url('${cover(p.id)}')`}>
                  {p.data.category && <span class="post-cat">{p.data.category}</span>}
                </span>
                <span class="post-body">
                  <h3>{p.data.title}</h3>
                  <p class="post-desc">{p.data.description}</p>
                  <span class="post-foot">
                    <span class="date">{fmt(p.data.date)}</span>
                    <span class="read">Lire <Icon name="arrow" size={14} /></span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  /* Article vedette */
  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; background: #fff; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; color: var(--text); margin-bottom: 44px; transition: transform .2s ease, box-shadow .2s ease; }
  .feat:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); text-decoration: none; }
  .feat-img { background-size: cover; background-position: center; min-height: 340px; }
  .feat-body { display: flex; flex-direction: column; justify-content: center; padding: 44px 46px; }
  .feat-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .feat-latest { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
  .feat-body h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: 14px; color: var(--navy); }
  .feat-desc { color: var(--text-muted); font-size: 1.02rem; margin-bottom: 22px; }
  .feat-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .cat { display: inline-block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--gold-strong); background: rgba(201,162,75,.12); padding: 5px 12px; border-radius: 20px; }

  /* Grille */
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .post-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; color: var(--text); transition: transform .2s ease, box-shadow .2s ease; }
  .post-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); text-decoration: none; }
  .post-img { display: block; height: 180px; background-size: cover; background-position: center; position: relative; }
  .post-cat { position: absolute; left: 14px; top: 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #fff; background: rgba(13,20,90,.92); padding: 5px 11px; border-radius: 20px; }
  .post-body { display: flex; flex-direction: column; flex: 1; padding: 24px; }
  .post-body h3 { font-size: 1.18rem; margin-bottom: 10px; color: var(--navy); line-height: 1.3; }
  .post-desc { color: var(--text-muted); font-size: 0.93rem; flex-grow: 1; }
  .post-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; }
  .date { font-size: 0.85rem; color: var(--text-muted); }
  .read { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; color: var(--brand); }
  .post-card:hover .read { gap: 10px; transition: gap .2s ease; }

  .blog-empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
  .blog-empty svg { color: var(--gold-strong); margin-bottom: 12px; }
  .blog-empty h2 { margin-bottom: 8px; }

  @media (max-width: 920px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .feat { grid-template-columns: 1fr; }
    .feat-img { min-height: 220px; }
    .feat-body { padding: 30px 26px; }
    .blog-grid { grid-template-columns: 1fr; }
  }
</style>

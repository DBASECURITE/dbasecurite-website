---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = (d: Date) => d.toLocaleDateString('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' });

// Couverture par article (photos DBA). Modifiable librement.
const covers: Record<string, string> = {
  'surete-ou-securite': '/assets/photos/expertise-evenement.jpg',
  'concept-de-surete': '/assets/photos/services-audit.jpg',
  'analyse-de-risques-surete': '/assets/photos/gestion-foule-international.jpg',
  'audit-de-surete-site': '/assets/photos/scrasa-chantier.jpg',
  'defense-en-profondeur-securite-physique': '/assets/photos/securite-evenementielle-wef.jpg',
  'appel-offres-securite-cahier-des-charges': '/assets/photos/services-specialises-wef.jpg',
  'concept-securite-manifestation': '/assets/photos/manifestation-geneve.jpg',
  'coordination-securite-evenement': '/assets/photos/services-coordination.jpg',
  'exercice-grandeur-nature-stade-de-geneve': '/assets/photos/stade-geneve-briefing.jpg',
  'test-intrusion-physique': '/assets/photos/manifestation-vaud.jpg',
  'gestion-de-crise-direction': '/assets/photos/formation-page.jpg',
  'sensibilisation-surete-collaborateurs': '/assets/photos/expertise-defile.jpg',
};
const cover = (id: string) => (covers[id] ?? '/assets/photos/stade-geneve-briefing.jpg');

const featured = posts[0];
const rest = posts.slice(1);
---
<Base title={`Blog & analyses - ${site.name}`} description="Analyses d'expert en sûreté et sécurité physique : concepts, gestion de crise, sécurité événementielle.">
  <PageHero
    eyebrow="Blog & analyses"
    title="Regards d'expert sur la sûreté"
    subtitle="Nos analyses sur les concepts de sécurité, la gestion de crise et la protection des grands événements."
  />

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="blog-empty">
          <Icon name="file" size={40} />
          <h2>Premiers articles à venir</h2>
          <p>Nos analyses seront publiées ici prochainement.</p>
        </div>
      ) : (
        <>
          {featured && (
            <a href={`/blog/${featured.id}`} class="feat">
              <span class="feat-img" style={`background-image:url('${cover(featured.id)}')`}></span>
              <span class="feat-body">
                <span class="feat-meta">
                  {featured.data.category && <span class="cat">{featured.data.category}</span>}
                  <span class="feat-latest">Dernier article</span>
                </span>
                <h2>{featured.data.title}</h2>
                <p class="feat-desc">{featured.data.description}</p>
                <span class="feat-foot">
                  <span class="date">{fmt(featured.data.date)}</span>
                  <span class="read">Lire l'article <Icon name="arrow" size={16} /></span>
                </span>
              </span>
            </a>
          )}

          <div class="blog-grid">
            {rest.map((p) => (
              <a href={`/blog/${p.id}`} class="post-card">
                <span class="post-img" style={`background-image:url('${cover(p.id)}')`}></span>
                <span class="post-body">
                  {p.data.category && <span class="post-cat">{p.data.category}</span>}
                  <h3>{p.data.title}</h3>
                  <span class="post-date">{fmt(p.data.date)}</span>
                </span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  /* Article vedette */
  .feat { display: block; color: var(--text); margin-bottom: 56px; }
  .feat:hover { text-decoration: none; }
  .feat-img { width: 100%; height: 400px; background-size: cover; background-position: center; border-radius: 18px; transition: box-shadow .2s ease; }
  .feat:hover .feat-img { box-shadow: var(--shadow-lg); }
  .feat-body { padding: 26px 2px 0; max-width: 860px; }
  .feat-meta { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .feat-latest { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
  .feat-body h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin-bottom: 14px; color: var(--navy); transition: color .2s ease; }
  .feat:hover .feat-body h2 { color: var(--gold-strong); }
  .feat-desc { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 20px; max-width: 70ch; }
  .feat-foot { display: flex; align-items: center; gap: 20px; }
  .feat-foot .date { font-size: 0.9rem; color: var(--text-muted); }
  .feat-foot .read { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: var(--brand); }
  .feat:hover .feat-foot .read { gap: 11px; transition: gap .2s ease; }
  .cat { display: inline-block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: #fff; background: var(--navy); padding: 6px 13px; border-radius: 6px; }

  /* Grille */
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .post-card { display: flex; flex-direction: column; color: var(--text); transition: transform .2s ease; }
  .post-card:hover { text-decoration: none; }
  .post-img { display: block; height: 220px; background-size: cover; background-position: center; border-radius: 14px; transition: box-shadow .2s ease; }
  .post-card:hover .post-img { box-shadow: var(--shadow-lg); }
  .post-body { display: flex; flex-direction: column; flex: 1; padding: 20px 2px 0; }
  .post-cat { align-self: flex-start; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #fff; background: var(--navy); padding: 6px 12px; border-radius: 6px; margin-bottom: 14px; }
  .post-body h3 { font-size: 1.2rem; color: var(--navy); line-height: 1.32; flex: 1; transition: color .2s ease; }
  .post-card:hover .post-body h3 { color: var(--gold-strong); }
  .post-date { font-size: 0.85rem; color: var(--text-muted); margin-top: 14px; }

  .blog-empty { text-align: center; padding: 60px 20px; color: var(--text-muted); }
  .blog-empty svg { color: var(--gold-strong); margin-bottom: 12px; }
  .blog-empty h2 { margin-bottom: 8px; }

  @media (max-width: 920px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .feat-img { height: 230px; }
    .feat-body { padding: 22px 0 0; }
    .blog-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

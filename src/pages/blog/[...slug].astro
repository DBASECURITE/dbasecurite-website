---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.title} - DBA Sécurité`} description={post.data.description}>
  <article>
    <header class="article-hero section--dark">
      <div class="container">
        <a href="/blog" class="back-link"><Icon name="arrow" size={15} /> Blog &amp; analyses</a>
        {post.data.category && <p class="eyebrow">{post.data.category}</p>}
        <h1>{post.data.title}</h1>
        <p class="article-meta">{post.data.author} · {fmt(post.data.date)}</p>
      </div>
    </header>

    <div class="section">
      <div class="container article-body">
        <Content />
      </div>
    </div>
  </article>

  <FinalCTA />
</Base>

<style>
  .article-hero { padding: 66px 0 54px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--gold); font-weight: 600; font-size: 14px; margin-bottom: 20px; }
  .back-link svg { transform: rotate(180deg); }
  .article-hero h1 { max-width: 820px; }
  .article-meta { color: rgba(255,255,255,0.75); font-size: 0.95rem; margin: 8px 0 0; }

  .article-body { max-width: 720px; }
  .article-body :global(h2) { margin-top: 2em; margin-bottom: 0.5em; }
  .article-body :global(h3) { margin-top: 1.6em; }
  .article-body :global(p) { font-size: 1.05rem; line-height: 1.8; }
  .article-body :global(ul), .article-body :global(ol) { line-height: 1.8; padding-left: 1.2em; }
  .article-body :global(a) { color: var(--brand); font-weight: 600; }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5em 0; }
  .article-body :global(strong) { color: var(--navy); }
  .article-body :global(blockquote) { border-left: 3px solid var(--gold); padding-left: 18px; color: var(--text-muted); font-style: italic; margin: 1.5em 0; }
</style>

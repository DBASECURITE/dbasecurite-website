---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---
<Base title="Audit, sûreté événementielle & formation - DBA Sécurité" description="Nos services : audit et conseil en sûreté, concepts de sécurité et analyse de risques, sécurité et coordination événementielle, coaching, formation et tests d'intrusion.">
  <PageHero
    eyebrow="Nos services"
    title="Une gamme complète d'expertises en sécurité"
    subtitle="De l'analyse de risques à la sécurisation de vos événements, nous couvrons l'ensemble de la chaîne de la sûreté physique."
  />

  {services.map((s, i) => (
    <section id={s.slug} class:list={['section', 'service-block', { 'section--soft': i % 2 === 1 }]}>
      <div class="container service-row">
        <div class="service-visual">
          {s.image
            ? <img src={s.image} alt={s.title} class="service-photo" loading="lazy" />
            : <span class="service-big-icon"><Icon name={s.icon} size={40} /></span>}
        </div>
        <div class="service-content">
          <p class="eyebrow">{s.subtitle}</p>
          <h2>{s.title}</h2>
          <p class="lead">{s.description}</p>
          {s.points && (
            <ul class="service-points">
              {s.points.map((p) => <li><Icon name="check" size={18} /> {p}</li>)}
            </ul>
          )}
          <div class="service-actions">
            {s.cta && (
              <a href="/contact" class="btn btn--gold service-cta">{s.cta} <Icon name="arrow" size={16} /></a>
            )}
            {s.landing && (
              <a href={s.landing} class="service-detail-link">Découvrir ce service en détail <Icon name="arrow" size={15} /></a>
            )}
          </div>
          {s.related && s.related.length > 0 && (
            <div class="service-related">
              <p class="service-related-label">Pour aller plus loin</p>
              <ul>
                {s.related.map((r) => (
                  <li><a href={`/blog/${r.slug}`}><Icon name="arrow" size={14} /> {r.label}</a></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <FinalCTA />
</Base>

<style>
  .service-block { scroll-margin-top: 90px; padding: 72px 0; }
  .service-row { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: center; }
  .service-visual { display: flex; align-items: center; justify-content: center; }
  .service-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .service-big-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 132px; height: 132px; border-radius: 28px;
    background: var(--gradient); color: #fff;
  }
  .service-content h2 { margin-bottom: 14px; }
  .service-points { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .service-points li { display: flex; align-items: center; gap: 10px; font-weight: 500; color: var(--navy); }
  .service-points svg { color: var(--gold-strong); flex-shrink: 0; }
  .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 26px; }
  .service-cta { margin-top: 0; }
  .service-detail-link { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; font-size: 0.95rem; color: var(--brand); }
  .service-detail-link:hover { gap: 11px; transition: gap 0.2s ease; }
  .service-related { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--border); }
  .service-related-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold-strong); margin: 0 0 12px; }
  .service-related ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .service-related a { display: inline-flex; align-items: baseline; gap: 8px; color: var(--navy); font-weight: 500; font-size: 0.95rem; line-height: 1.4; }
  .service-related a:hover { color: var(--brand); }
  .service-related svg { color: var(--gold-strong); flex-shrink: 0; transform: translateY(1px); }

  @media (max-width: 780px) {
    .service-row { grid-template-columns: 1fr; gap: 24px; }
    .service-visual { justify-content: flex-start; }
    .service-big-icon { width: 96px; height: 96px; border-radius: 22px; }
    .service-points { grid-template-columns: 1fr; }
  }
</style>

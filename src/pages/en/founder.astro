---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';

const domaines = [
  { icon: 'calendar', title: 'Security of major events', text: 'Design and coordination of set-ups for sporting, cultural and prestige events.' },
  { icon: 'target', title: 'Crisis & threat management', text: 'Anticipating scenarios, response plans and preparation for current threats.' },
  { icon: 'shield', title: 'Security concepts & audits', text: 'Risk analysis and the design of bespoke protection concepts.' },
  { icon: 'graduation', title: 'Training & exercises', text: 'Upskilling teams and full-scale exercises under real conditions.' },
];
---
<Base title="Daniel Barouch - Physical security expert" description="Daniel Barouch, founder of DBA Sécurité: expert in event security, crisis management and physical security concepts.">
  <PageHero
    eyebrow="The founder"
    title="Daniel Barouch"
    subtitle="Expert in physical security, specialist in the protection of major events and crisis management."
  />

  <section class="section">
    <div class="container expert-grid">
      <div class="expert-photo">
        <img src="/assets/photos/portrait-daniel-barouch.jpg" alt="Daniel Barouch, founder of DBA Sécurité" class="expert-portrait" width="900" height="1072" />
        <a href={site.linkedin} target="_blank" rel="noopener" class="expert-linkedin">
          <Icon name="linkedin" size={18} /> LinkedIn profile
        </a>
      </div>
      <div class="expert-bio">
        <p class="lead">Founder of DBA Sécurité, Daniel Barouch brings more than twenty years of physical security experience to his clients - from the field to the direction of large-scale operations, in Switzerland and internationally.</p>
        <p>For more than six years, he led an operational department of a major private security company in Switzerland, managing up to 500 to 600 staff and overseeing sensitive, strategic assignments: international diplomatic engagements, international organisations and institutions, in close coordination with the authorities.</p>
        <p>Previously responsible for the physical security of a leading international organisation, he secured sensitive sites and official visits - heads of state, ministers and protected figures - at events in Switzerland and abroad, and designed the crisis-management and evacuation concepts for high-level diplomatic and economic events.</p>
        <p>An entrepreneur, he founded and ran several security companies and personally secured hundreds of festive, cultural and sporting events. Now at the head of DBA Sécurité, he notably served as security lead for the Stade de Genève and security consultant for the Canton of Geneva for the 2025 Women's Euro, running a full-scale exercise of close to 400 responders. Regularly sought by the media, he shares his analysis on response methods and the evolution of threats.</p>

        <div class="cred">
          <h3>Education &amp; certifications</h3>
          <ul>
            <li><Icon name="check" size={18} /><span>BA, MA (University of Geneva) and MsBA (HES-SO).</span></li>
            <li><Icon name="check" size={18} /><span>Certified Protection Professional® (CPP) - ASIS International, the highest international certification in security management.</span></li>
            <li><Icon name="check" size={18} /><span>CAS in crisis communication (ZHAW).</span></li>
            <li><Icon name="check" size={18} /><span>Military judge in the Swiss Army.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHeader eyebrow="Areas of expertise" title="A specialisation in physical security" center />
      <div class="domaines-grid">
        {domaines.map((d) => (
          <div class="domaine-card">
            <span class="domaine-icon"><Icon name={d.icon} size={24} /></span>
            <div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCTA title="A project to secure?" text="Let's discuss your physical security challenges." />
</Base>

<style>
  .expert-grid { display: grid; grid-template-columns: 320px 1fr; gap: 48px; align-items: start; }
  .expert-photo { position: sticky; top: 96px; }
  .expert-portrait { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top center; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .expert-linkedin { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; font-weight: 600; font-size: 14px; }
  .expert-bio .lead { color: var(--text); }
  .expert-bio p { text-align: justify; }
  .cred { margin-top: 26px; padding: 22px 24px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--soft); }
  .cred h3 { font-size: 1rem; margin-bottom: 14px; }
  .cred ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .cred li { display: flex; gap: 11px; align-items: flex-start; font-size: 0.95rem; color: var(--text); line-height: 1.5; }
  .cred li svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 3px; }

  .domaines-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .domaine-card { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 24px; }
  .domaine-icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: var(--mist); color: var(--brand); flex-shrink: 0; }
  .domaine-card h3 { margin-bottom: 4px; }
  .domaine-card p { color: var(--text-muted); margin: 0; }

  @media (max-width: 820px) {
    .expert-grid { grid-template-columns: 1fr; gap: 28px; }
    .expert-photo { position: static; max-width: 280px; }
    .domaines-grid { grid-template-columns: 1fr; }
  }
</style>

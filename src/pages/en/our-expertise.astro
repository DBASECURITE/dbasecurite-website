---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Icon from '../../components/Icon.astro';

const steps = [
  { icon: 'eye', title: 'Understand', text: 'We start from your real context: activity, exposure, plausible threats and existing measures - not from a product catalogue.' },
  { icon: 'shield', title: 'Design', text: 'We formalise proportionate organisational, human and technical measures in a coherent security concept.' },
  { icon: 'target', title: 'Test', text: 'We put the set-up to the test under real conditions - full-scale exercises, penetration tests - to reveal weaknesses while there is still time.' },
  { icon: 'spark', title: 'Support', text: 'We help implement, coordinate on the ground and train your teams, so the set-up holds on the day.' },
];
---
<Base title="Expert in physical security - DBA Sécurité" description="DBA Sécurité: physical security expertise, from the security concept to the full-scale exercise. We design security measures and test them under real conditions.">
  <PageHero
    eyebrow="Our expertise"
    title="We design security. And we test it."
    subtitle="Physical security expertise for sensitive sites, organisations and major events - from the concept to the full-scale exercise."
  />

  <section class="section">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Our difference</p>
        <h2 class="h-accent">Designing is only half the work</h2>
        <p class="lead">Most security concepts are never tested: they hold on paper, not necessarily on the ground. DBA Sécurité does the opposite - we design your set-up, then we put it to the test under real conditions.</p>
        <p class="muted">Our advice is independent of manufacturers and comes with no obligation to execute: it serves only your protection, never the sale of equipment or guarding services.</p>
      </div>
      <div class="two-col-img">
        <img src="/assets/photos/expertise-evenement.jpg" alt="Security operation at an event" />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <SectionHeader eyebrow="Our method" title="From real risk to a set-up that holds" center />
      <div class="steps-grid">
        {steps.map((s, i) => (
          <div class="step">
            <span class="step-no">0{i + 1}</span>
            <span class="step-icon"><Icon name={s.icon} size={24} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div class="two-col-img">
        <img src="/assets/photos/expertise-defile.jpg" alt="Event security coordination" />
      </div>
      <div>
        <p class="eyebrow">A key distinction</p>
        <h2 class="h-accent">Security and safety</h2>
        <p>In French, we distinguish <em>sûreté</em> (security) from <em>sécurité</em> (safety). <strong>Security</strong> addresses intentional, malicious acts - intrusion, aggression, threat. <strong>Safety</strong> addresses accidental risks - fire, crowd movement, incident.</p>
        <p class="muted">A complete set-up must handle both, and a good concept never confuses them. That clarity is the first step of solid protection.</p>
      </div>
    </div>
  </section>

  <FinalCTA />
</Base>

<style>
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .two-col h2 { margin-bottom: 16px; }
  .two-col .lead { margin-bottom: 16px; }
  .two-col .muted { color: var(--text-muted); }
  .two-col-img img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }

  .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .step { position: relative; background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 24px; }
  .step-no { font-size: 14px; font-weight: 700; color: var(--gold-strong); }
  .step-icon { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 12px; background: var(--mist); color: var(--brand); margin: 12px 0; }
  .step h3 { margin-bottom: 6px; }
  .step p { color: var(--text-muted); font-size: 14px; margin: 0; }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; gap: 28px; }
    .two-col-img { order: -1; }
    .steps-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .steps-grid { grid-template-columns: 1fr; } }
</style>

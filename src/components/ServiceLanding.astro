---
import PageHero from './PageHero.astro';
import SectionHeader from './SectionHeader.astro';
import FinalCTA from './FinalCTA.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

export interface Step { icon: string; title: string; text: string; }
export interface ProofAction { href: string; label: string; variant?: 'light' | 'ghost'; }
export interface ProofStat { num: string; label: string; }
export interface Faq { q: string; a: string; }
export interface RelatedLink { label: string; slug: string; }

export interface Props {
  path: string;                 // ex. '/test-intrusion-physique'
  serviceType: string;          // pour le JSON-LD Service
  serviceDescription: string;
  // Hero
  eyebrow: string;
  title: string;
  subtitle: string;
  // Enjeu
  enjeuTitle: string;
  enjeuText: string;
  image?: string; // illustration affichée dans la section "L'enjeu"
  // Méthode
  stepsEyebrow?: string;
  stepsTitle: string;
  steps: Step[];
  // Livrables
  livrablesTitle: string;
  livrablesText: string;
  livrables: string[];
  // Preuve
  proof?: { eyebrow: string; title: string; text: string; actions?: ProofAction[]; stats?: ProofStat[] };
  // FAQ
  faqs: Faq[];
  // Pour aller plus loin
  relatedTitle?: string;
  related: RelatedLink[];
  // CTA
  cta: { title: string; text: string };
}

const {
  path, serviceType, serviceDescription,
  eyebrow, title, subtitle,
  enjeuTitle, enjeuText, image,
  stepsEyebrow = 'Notre approche', stepsTitle, steps,
  livrablesTitle, livrablesText, livrables,
  proof,
  faqs,
  relatedTitle = 'Nos analyses sur le sujet',
  related,
  cta,
} = Astro.props;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  serviceType,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['Genève', 'Suisse romande', 'Suisse'],
  description: serviceDescription,
  url: new URL(path, site.url).href,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<PageHero eyebrow={eyebrow} title={title} subtitle={subtitle} />

<!-- REPÈRES -->
<section class="reperes">
  <div class="container reperes-grid">
    <div><b>20+ ans</b><span>d'expérience en sûreté</span></div>
    <div><b>500+ événements</b><span>sportifs, culturels, diplomatiques, festifs</span></div>
    <div><b>Suisse &amp; international</b><span>zone d'intervention</span></div>
  </div>
</section>

<!-- ENJEU -->
<section class="section">
  <div class:list={['container', 'enjeu', { 'enjeu--split': image }]}>
    <div class="enjeu-text">
      <p class="eyebrow">L'enjeu</p>
      <h2>{enjeuTitle}</h2>
      <p class="lead">{enjeuText}</p>
    </div>
    {image && (
      <div class="enjeu-media">
        <img src={image} alt={title} class="enjeu-img" loading="lazy" />
      </div>
    )}
  </div>
</section>

<!-- METHODE -->
<section class="section section--soft">
  <div class="container">
    <SectionHeader eyebrow={stepsEyebrow} title={stepsTitle} center />
    <div class="steps-grid">
      {steps.map((e, i) => (
        <div class="step-card">
          <span class="step-num">{i + 1}</span>
          <span class="step-icon"><Icon name={e.icon} size={24} /></span>
          <h3>{e.title}</h3>
          <p>{e.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- LIVRABLES -->
<section class="section">
  <div class="container livrables-grid">
    <div>
      <p class="eyebrow">Ce que vous recevez</p>
      <h2>{livrablesTitle}</h2>
      <p class="lead">{livrablesText}</p>
    </div>
    <ul class="livrables-list">
      {livrables.map((l) => (
        <li><Icon name="check" size={18} /> <span>{l}</span></li>
      ))}
    </ul>
  </div>
</section>

<!-- PREUVE -->
{proof && (
  <section class="section section--dark proof">
    <div class="container proof-inner">
      <div>
        <p class="eyebrow">{proof.eyebrow}</p>
        <h2>{proof.title}</h2>
        <p class="lead">{proof.text}</p>
        {proof.actions && proof.actions.length > 0 && (
          <div class="proof-actions">
            {proof.actions.map((a) => (
              <a href={a.href} class:list={['btn', a.variant === 'ghost' ? 'btn--ghost-light' : 'btn--light']}>
                {a.label}{a.variant !== 'ghost' && <Icon name="arrow" size={16} />}
              </a>
            ))}
          </div>
        )}
      </div>
      {proof.stats && proof.stats.length > 0 && (
        <div class="proof-stats">
          {proof.stats.map((s) => (
            <div class="pstat"><span class="pstat-num">{s.num}</span><span class="pstat-label">{s.label}</span></div>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<!-- FAQ -->
<section class="section">
  <div class="container faq-wrap">
    <SectionHeader eyebrow="Questions fréquentes" title="Les questions que l'on nous pose" center />
    {faqs.map((f) => (
      <details class="faq-item">
        <summary><span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>

<!-- POUR ALLER PLUS LOIN -->
{related && related.length > 0 && (
  <section class="section section--soft">
    <div class="container related-wrap">
      <p class="eyebrow">Pour aller plus loin</p>
      <h2>{relatedTitle}</h2>
      <ul class="related-list">
        {related.map((r) => (
          <li><a href={r.slug.startsWith('/') ? r.slug : `/blog/${r.slug}`}><Icon name="arrow" size={16} /> {r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<FinalCTA title={cta.title} text={cta.text} />

<style>
  .reperes { background: #fff; border-bottom: 1px solid var(--border); padding: 30px 0; }
  .reperes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: center; }
  .reperes-grid > div { text-align: center; position: relative; }
  .reperes-grid > div + div::before { content: ''; position: absolute; left: -12px; top: 50%; transform: translateY(-50%); width: 1px; height: 46px; background: var(--border); }
  .reperes-grid b { display: block; font-size: 1.65rem; font-weight: 700; color: var(--navy); line-height: 1.1; letter-spacing: -.02em; }
  .reperes-grid span { font-size: 13px; color: var(--text-muted); }
  @media (max-width: 760px) {
    .reperes-grid { grid-template-columns: 1fr; gap: 16px; }
    .reperes-grid > div + div::before { display: none; }
    .reperes-grid b { font-size: 1.4rem; }
  }

  .enjeu { max-width: 820px; }
  .enjeu h2 { margin-bottom: 16px; }
  .enjeu--split { max-width: none; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 50px; align-items: center; }
  .enjeu--split .enjeu-text { max-width: 560px; }
  .enjeu-img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); display: block; }
  @media (max-width: 820px) {
    .enjeu--split { grid-template-columns: 1fr; gap: 28px; }
    .enjeu--split .enjeu-media { order: -1; }
  }

  .steps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .step-card {
    position: relative; background: #fff; border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 30px 28px;
  }
  .step-num {
    position: absolute; top: 24px; right: 26px;
    font-size: 2.2rem; font-weight: 700; color: var(--mist); line-height: 1;
  }
  .step-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 13px;
    background: var(--mist); color: var(--brand); margin-bottom: 16px;
  }
  .step-card h3 { margin-bottom: 8px; }
  .step-card p { color: var(--text-muted); margin: 0; }

  .livrables-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .livrables-grid h2 { margin-bottom: 14px; }
  .livrables-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .livrables-list li { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; color: var(--navy); }
  .livrables-list svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 3px; }

  .proof-inner { display: grid; grid-template-columns: 1.5fr 1fr; gap: 44px; align-items: center; }
  .proof-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .proof-stats { display: flex; flex-direction: column; gap: 22px; }
  .pstat { display: flex; flex-direction: column; border-left: 3px solid var(--gold); padding-left: 18px; }
  .pstat-num { font-size: 1.8rem; font-weight: 700; color: #fff; line-height: 1.1; }
  .pstat-label { font-size: 0.9rem; color: var(--gold); margin-top: 6px; }

  .faq-wrap { max-width: 820px; }
  .faq-item { border: 1px solid var(--border); border-radius: var(--radius-lg); background: #fff; overflow: hidden; margin-bottom: 12px; }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 22px 24px; cursor: pointer; font-weight: 600; color: var(--navy); font-size: 1.05rem; list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; width: 18px; height: 18px; flex-shrink: 0; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; background: var(--gold-strong); border-radius: 2px; transition: transform 0.2s ease; }
  .faq-plus::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq-plus::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-answer { padding: 0 24px 22px; }
  .faq-answer p { color: var(--text-muted); margin: 0; line-height: 1.7; }

  .related-wrap { max-width: 820px; }
  .related-wrap h2 { margin-bottom: 20px; }
  .related-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .related-list a { display: inline-flex; align-items: baseline; gap: 10px; color: var(--navy); font-weight: 600; font-size: 1.05rem; }
  .related-list a:hover { color: var(--brand); }
  .related-list svg { color: var(--gold-strong); flex-shrink: 0; transform: translateY(2px); }

  @media (max-width: 820px) {
    .steps-grid { grid-template-columns: 1fr; }
    .livrables-grid { grid-template-columns: 1fr; gap: 28px; }
    .proof-inner { grid-template-columns: 1fr; gap: 28px; }
    .proof-stats { flex-direction: row; flex-wrap: wrap; }
  }
</style>

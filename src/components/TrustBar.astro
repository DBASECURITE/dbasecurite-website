---
const logos: { src: string; alt: string; dark?: boolean }[] = [
  { src: '/assets/logos/ifrc.png', alt: 'IFRC - Fédération internationale de la Croix-Rouge' },
  { src: '/assets/logos/uefa-youth-league.jpg', alt: 'UEFA Youth League' },
  { src: '/assets/logos/weuro-2025.jpg', alt: "UEFA Women's Euro 2025" },
  { src: '/assets/logos/moncler.jpg', alt: 'Moncler' },
  { src: '/assets/logos/scrasa.png', alt: 'SCRASA' },
  { src: '/assets/logos/chancy.png', alt: 'Commune de Chancy' },
  { src: '/assets/logos/edgward-full.png', alt: 'Edgward', dark: true },
  { src: '/assets/logos/fsg.jpg', alt: 'Fondation du Stade de Genève' },
];
---
<div class="trustbar-wrap" role="group" aria-label="Nos références">
  <div class="trustbar">
    {[0, 1].map((set) => (
      <ul class="tb-set" aria-hidden={set === 1 ? 'true' : undefined}>
        {logos.map((l) => (
          <li class:list={['trustbar-item', { 'trustbar-item--dark': l.dark }]}>
            <img src={l.src} alt={set === 1 ? '' : l.alt} />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .trustbar-wrap {
    overflow: hidden;
    margin: 0 auto 40px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .trustbar {
    display: flex;
    width: max-content;
    animation: tb-scroll 42s linear infinite;
  }
  .trustbar-wrap:hover .trustbar { animation-play-state: paused; }
  .tb-set {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
    margin: 0;
    list-style: none;
  }
  .trustbar-item {
    flex-shrink: 0;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 158px;
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
  }
  .trustbar-item img {
    max-height: 54px;
    max-width: 120px;
    width: auto;
    object-fit: contain;
  }
  .trustbar-item--dark {
    background: var(--gradient);
    border-color: transparent;
  }
  .trustbar-item--dark img { max-width: 128px; }

  @keyframes tb-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .trustbar { animation: none; flex-wrap: wrap; justify-content: center; }
    .tb-set:last-child { display: none; }
  }
</style>

---
const logos = [
  { src: '/assets/logos/ifrc.png', alt: 'IFRC - Fédération internationale de la Croix-Rouge' },
  { src: '/assets/logos/uefa-youth-league.jpg', alt: 'UEFA Youth League' },
  { src: '/assets/logos/weuro-2025.jpg', alt: "UEFA Women's Euro 2025" },
  { src: '/assets/logos/moncler.jpg', alt: 'Moncler' },
  { src: '/assets/logos/scrasa.jpg', alt: 'SCRASA' },
  { src: '/assets/logos/fsg.jpg', alt: 'Fondation du Stade de Genève' },
];
---
<ul class="trustbar">
  {logos.map((l) => (
    <li class="trustbar-item">
      <img src={l.src} alt={l.alt} loading="lazy" />
    </li>
  ))}
</ul>

<style>
  .trustbar {
    list-style: none;
    margin: 0 auto 40px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }
  .trustbar-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 158px;
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
  }
  .trustbar-item {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .trustbar-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-sm); }
  .trustbar-item img {
    max-height: 54px;
    max-width: 120px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 560px) {
    .trustbar-item { width: 45%; height: 78px; }
  }
</style>

---
import Icon from './Icon.astro';
import { localeFromPath } from '../data/i18n';
const locale = localeFromPath(Astro.url.pathname);
const t = locale === 'en'
  ? {
      eyebrow: 'Operational partner',
      title: 'From strategy to intervention',
      text: 'DBA Sécurité designs, audits and coordinates your security. For operational deployment on the ground, we rely on Edgward, the on-demand security service in French-speaking Switzerland.',
      cta: 'Discover Edgward',
    }
  : {
      eyebrow: 'Partenaire opérationnel',
      title: "De la stratégie à l'intervention",
      text: "DBA Sécurité conçoit, audite et coordonne votre sûreté. Pour l'intervention opérationnelle sur le terrain, nous nous appuyons sur Edgward, le service de sécurité à la demande en Suisse romande.",
      cta: 'Découvrir Edgward',
    };
---
<section class="section partner">
  <div class="container">
    <div class="partner-band">
      <div class="partner-text">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p>{t.text}</p>
      </div>
      <div class="partner-brand">
        <span class="partner-logo-plate">
          <img src="/assets/logos/edgward-full.png" alt="Edgward" class="partner-logo" width="210" height="48" loading="lazy" />
        </span>
        <a href="https://edgward.ch" target="_blank" rel="noopener" class="btn btn--outline partner-btn">
          {t.cta} <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .partner-band {
    display: flex;
    align-items: center;
    gap: 44px;
    max-width: 960px;
    margin: 0 auto;
    background: var(--soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 38px 46px;
  }
  .partner-text { flex: 1.5; }
  .partner-text h2 { font-size: 1.5rem; margin: 6px 0 12px; }
  .partner-text p { color: var(--text-muted); margin: 0; }
  .partner-brand {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    border-left: 1px solid var(--border);
    padding-left: 44px;
  }
  .partner-logo-plate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient);
    border-radius: 12px;
    padding: 20px 30px;
  }
  .partner-logo { width: 200px; height: auto; display: block; }

  @media (max-width: 760px) {
    .partner-band { flex-direction: column; gap: 26px; padding: 32px 26px; text-align: center; }
    .partner-brand {
      border-left: none;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 26px;
      width: 100%;
    }
  }
</style>

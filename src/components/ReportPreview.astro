---
// Version compacte (une reco par horizon au moins). Extrait fictif et impersonnel d'un rapport d'audit DBA : synthèse chiffrée, maturité en trois regards,
// recommandations par horizon. Montre la forme du livrable sans livrer la grille d'évaluation.
import { localeFromPath } from '../data/i18n';

const en = localeFromPath(Astro.url.pathname) === 'en';

const T = en
  ? {
      aria: 'Fictitious excerpt from a security audit report',
      title: 'Security audit report', sub: 'Fictitious example · excerpt',
      s1: '1. Executive summary', msgTitle: 'Key message',
      msg: 'The site has recent equipment and a working monitoring and response chain. What is missing is not hardware, but the framework that makes it enforceable: written rules, assigned roles and prepared teams.',
      kpis: [
        { n: '38', l: 'Rated hazards', s: '4 at high level or above' },
        { n: '12', l: 'Findings', s: 'across 6 analysis blocks' },
        { n: '10', l: 'Measures', s: 'spread over 12 months' },
        { n: '30', l: 'Estimated effort days', s: 'for implementation' },
      ],
      s2: '2. Where the site stands, from three angles', s2short: 'Maturity by area', s3short: 'Recommendations by horizon',
      lvl: (n: number) => `Level ${n} of 3`,
      domains: [
        { d: 'Human', n: 1, v: 'Committed teams, little preparation' },
        { d: 'Technical', n: 2, v: 'Good equipment, a few blind spots' },
        { d: 'Organisational', n: 1, v: 'Habits rather than written rules' },
      ],
      scale: ['0 - non-existent', '1 - informal', '2 - written and applied', '3 - written, applied and checked'],
      s3: '3. Measures & recommendations', cols: ['No.', 'Recommendation', 'Horizon'],
      hz: { i: 'Immediate', s: 'Structural', f: 'Long-term' },
      recos: [
        ['Formalise the priority security procedures', 'i'],
        ['Train the most exposed staff', 'i'],
        ['Restrict out-of-hours access', 'i'],
        ['Extend video coverage to sensitive areas', 's'],
        ['Assign security responsibilities by role', 's'],
        ['Adopt a security charter', 'f'],
      ],
      hzLegend: 'Immediate: quick, low-dependency measures · Structural: require design and roll-out · Long-term: culture and framework',
      note: 'Illustrative excerpt. Each report is tailored to the site and to the assignment.',
    }
  : {
      aria: "Extrait fictif d'un rapport d'audit de sûreté",
      title: "Rapport d'audit de sûreté", sub: 'Exemple fictif · extrait',
      s1: '1. Synthèse pour la direction', msgTitle: 'Message central',
      msg: "Le site dispose d'équipements récents et d'une chaîne de surveillance et d'intervention qui fonctionne. Ce qui manque n'est pas le matériel, c'est le cadre qui le rend opposable : des règles écrites, des rôles attribués et des équipes préparées.",
      kpis: [
        { n: '38', l: 'Dangers cotés', s: 'dont 4 au niveau élevé ou supérieur' },
        { n: '12', l: 'Constats', s: "sur 6 blocs d'analyse" },
        { n: '10', l: 'Mesures', s: 'réparties sur 12 mois' },
        { n: '30', l: 'Jours-effort estimés', s: 'pour la mise en œuvre' },
      ],
      s2: '2. Où en est le site, en trois regards', s2short: 'Maturité par domaine', s3short: 'Recommandations par horizon',
      lvl: (n: number) => `Niveau ${n} sur 3`,
      domains: [
        { d: 'Humain', n: 1, v: 'Des équipes engagées, peu préparées' },
        { d: 'Technique', n: 2, v: 'Du bon matériel, quelques angles morts' },
        { d: 'Organisationnel', n: 1, v: "Des usages plutôt que des règles écrites" },
      ],
      scale: ['0 - inexistant', '1 - informel', '2 - écrit et appliqué', '3 - écrit, appliqué et contrôlé'],
      s3: '3. Mesures & recommandations', cols: ['N°', 'Recommandation', 'Horizon'],
      hz: { i: 'Immédiat', s: 'Structurel', f: 'De fond' },
      recos: [
        ['Formaliser les procédures de sûreté prioritaires', 'i'],
        ['Former les collaborateurs les plus exposés', 'i'],
        ["Restreindre l'accès en dehors des heures", 'i'],
        ['Étendre la couverture vidéo aux zones sensibles', 's'],
        ['Attribuer les responsabilités de sûreté par fonction', 's'],
        ['Établir une charte de sûreté', 'f'],
      ],
      hzLegend: 'Immédiat : mesures rapides et peu dépendantes · Structurel : conception et déploiement · De fond : culture et cadre',
      note: "Extrait fictif, à titre d'illustration. Chaque rapport est adapté au site et au mandat.",
    };
---
<div class="rp" role="img" aria-label={T.aria}>
  <div class="rp-bar">
    <img class="rp-logo" src="/assets/logo-dba-white.png" alt="" />
    <div><b>{T.title}</b><span>{T.sub}</span></div>
  </div>

  <div class="rp-body">
    <div class="rp-kpis">
      {T.kpis.map((k) => (
        <div class="rp-kpi"><span class="rp-n">{k.n}</span><span class="rp-l">{k.l}</span></div>
      ))}
    </div>

    <p class="rp-h">{T.s2short}</p>
    <div class="rp-domains">
      {T.domains.map((d) => (
        <div class="rp-dom">
          <span class="rp-dname">{d.d}</span>
          <span class="rp-meter">{[1, 2, 3].map((i) => <i class:list={{ on: i <= d.n }}></i>)}</span>
          <span class="rp-lvl">{d.n}/3</span>
        </div>
      ))}
    </div>

    <p class="rp-h">{T.s3short}</p>
    <ul class="rp-recos">
      {[0, 1, 3, 5].map((k) => T.recos[k]).map(([r, h], i) => (
        <li>
          <span class="rp-num">R{i + 1}</span>
          <span class="rp-rtext">{r}</span>
          <span class={`rp-hz rp-hz--${h}`}>{T.hz[h as 'i' | 's' | 'f']}</span>
        </li>
      ))}
    </ul>
    <p class="rp-note">{T.note}</p>
  </div>
</div>

<style>
  .rp { background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: 0 24px 50px rgba(13,20,90,.12); overflow: hidden; font-size: 13px; }
  .rp-bar { display: flex; align-items: center; gap: 10px; background: var(--navy); color: #fff; padding: 12px 18px; }
  .rp-logo { height: 26px; width: auto; flex-shrink: 0; }
  .rp-bar b { display: block; font-size: 13.5px; }
  .rp-bar span { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); }
  .rp-body { padding: 16px 18px 14px; }

  .rp-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .rp-kpi { display: flex; flex-direction: column; background: var(--soft); border-top: 2px solid var(--navy); border-radius: 5px; padding: 8px 10px; }
  .rp-n { font-size: 1.35rem; font-weight: 700; color: var(--gold-strong); line-height: 1.1; }
  .rp-l { font-size: 9.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--navy); line-height: 1.3; margin-top: 2px; }

  .rp-h { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--navy); margin: 14px 0 8px; padding-bottom: 5px; border-bottom: 1.5px solid var(--navy); }

  .rp-domains { display: flex; flex-direction: column; gap: 6px; }
  .rp-dom { display: grid; grid-template-columns: 112px 1fr 30px; align-items: center; gap: 10px; }
  .rp-dname { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--navy); }
  .rp-meter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .rp-meter i { height: 6px; border-radius: 3px; background: var(--mist); }
  .rp-meter i.on { background: var(--gold); }
  .rp-lvl { font-size: 11px; color: var(--text-muted); text-align: right; }

  .rp-recos { list-style: none; margin: 0; padding: 0; }
  .rp-recos li { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--border); }
  .rp-num { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 10px; font-weight: 700; }
  .rp-rtext { color: var(--text); line-height: 1.35; }
  .rp-hz { font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 4px; color: #3a2a05; white-space: nowrap; }
  .rp-hz--i { background: #EDB55A; }
  .rp-hz--s { background: #F6E8B1; }
  .rp-hz--f { background: #D3E9D1; color: #1f4a26; }
  .rp-note { font-size: 11px; color: var(--text-muted); font-style: italic; margin: 10px 0 0; }

  @media (max-width: 480px) {
    .rp-kpis { grid-template-columns: 1fr 1fr; }
    .rp-dom { grid-template-columns: 96px 1fr 28px; }
  }
</style>

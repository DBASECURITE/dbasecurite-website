---
// Gabarit des pages "secteur" (audit spécialisé par type de site).
// Alterne texte et image ; montre ce que nous faisons sans livrer la méthode détaillée.
import SectionHeader from './SectionHeader.astro';
import FinalCTA from './FinalCTA.astro';
import Icon from './Icon.astro';
import ReportPreview from './ReportPreview.astro';
import { site } from '../data/site';
import { localeFromPath } from '../data/i18n';

// Une image : soit un fichier (src), soit un emplacement réservé (placeholder) tant que la photo manque.
export interface Visual { src?: string; alt?: string; placeholder?: string; }
export interface Phase { title: string; text: string; }
// Sans visual, le bloc s'affiche en texte seul, centré.
export interface Block { eyebrow: string; title: string; text: string; points?: string[]; visual?: Visual; }
export interface Faq { q: string; a: string; }
export interface RelatedLink { label: string; slug: string; }

export interface Props {
  path: string;
  serviceType: string;
  serviceDescription: string;
  // Hero
  eyebrow: string;
  title: string;
  subtitle: string;
  heroVisual: Visual;
  reperes: { b: string; span: string }[];
  // Enjeu
  enjeuTitle: string;
  enjeuText: string[];
  enjeuVisual?: Visual; // sans visuel : texte seul, centré
  // Déroulé d'un incident : exactement 3 phases (avant, pendant, après)
  phasesEyebrow: string;
  phasesTitle: string;
  phases: [Phase, Phase, Phase];
  phasesFoot: string;
  // Ce que nous examinons (blocs alternés)
  blocksTitle: string;
  blocks: Block[];
  // Mandat réalisé (anonymisé)
  mandat: { label: string; title: string; contexte: string; mission: string; resultat: string; visual: Visual };
  // Livrable
  livrableTitle: string;
  livrableText: string;
  livrables: string[];
  // FAQ, liens, CTA
  faqs: Faq[];
  related: RelatedLink[];
  cta: { title: string; text: string };
}

const p = Astro.props;

const en = localeFromPath(Astro.url.pathname) === 'en';
const L = en
  ? {
      contact: '/en/contact', talk: 'Discuss your site', seeCase: 'See a completed assignment', photo: 'Photo to come',
      enjeu: 'The challenge', phases: ['Before', 'During', 'After'], examine: 'What we examine',
      mandat: 'Completed assignment', ctx: 'Context', mission: 'Our mission', result: 'Outcome',
      caseNote: 'Client anonymised at their request. Other references can be discussed at a first meeting.',
      deliver: 'What you get',
      faqEyebrow: 'FAQ', faqTitle: 'The questions we are asked', relEyebrow: 'Further reading', relTitle: 'Related services',
    }
  : {
      contact: '/contact', talk: 'Parler de votre site', seeCase: 'Voir un mandat réalisé', photo: 'Photo à fournir',
      enjeu: "L'enjeu", phases: ['Avant', 'Pendant', 'Après'], examine: 'Ce que nous examinons',
      mandat: 'Mandat réalisé', ctx: 'Contexte', mission: 'Notre mission', result: 'Résultat',
      caseNote: "Client anonymisé à sa demande. D'autres références peuvent être évoquées lors d'un premier entretien.",
      deliver: 'Ce que vous recevez',
      faqEyebrow: 'Questions fréquentes', faqTitle: "Les questions que l'on nous pose", relEyebrow: 'Pour aller plus loin', relTitle: 'Nos services et analyses liés',
    };

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: p.title,
  serviceType: p.serviceType,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['Genève', 'Suisse romande', 'Suisse'],
  description: p.serviceDescription,
  url: new URL(p.path, site.url).href,
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: p.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<!-- HERO IMAGE -->
<section class="sh">
  {p.heroVisual.src
    ? <img class="sh-bg" src={p.heroVisual.src} alt="" />
    : <div class="sh-bg sh-bg--ph"><span>{L.photo} : {p.heroVisual.placeholder}</span></div>}
  <div class="sh-overlay"></div>
  <div class="container sh-inner">
    <p class="eyebrow">{p.eyebrow}</p>
    <h1>{p.title}</h1>
    <p class="lead">{p.subtitle}</p>
    <div class="sh-actions">
      <a href={L.contact} class="btn btn--gold">{L.talk} <Icon name="arrow" size={18} /></a>
      <a href="#mandat" class="btn btn--ghost-light">{L.seeCase}</a>
    </div>
  </div>
</section>

<!-- REPÈRES -->
<section class="reperes">
  <div class="container reperes-grid" style={`--n:${p.reperes.length}`}>
    {p.reperes.map((r) => <div><b>{r.b}</b><span>{r.span}</span></div>)}
  </div>
</section>

<!-- ENJEU -->
<section class="section">
  <div class:list={['container', p.enjeuVisual ? 'split' : 'enjeu--text']}>
    <div class="split-text">
      <p class="eyebrow">{L.enjeu}</p>
      <h2>{p.enjeuTitle}</h2>
      {p.enjeuText.map((t, i) => <p class:list={[{ lead: i === 0 }]}>{t}</p>)}
    </div>
    {p.enjeuVisual && (
      <div class="split-media">
        {p.enjeuVisual.src
          ? <img src={p.enjeuVisual.src} alt={p.enjeuVisual.alt ?? ''} loading="lazy" />
          : <div class="ph"><Icon name="file" size={28} /><span>{L.photo}</span><small>{p.enjeuVisual.placeholder}</small></div>}
      </div>
    )}
  </div>
</section>

<!-- DÉROULÉ : AVANT / PENDANT / APRÈS -->
<section class="section section--soft">
  <div class="container">
    <div class="ph-head">
      <p class="eyebrow">{p.phasesEyebrow}</p>
      <h2>{p.phasesTitle}</h2>
    </div>
    <div class="ph-arrow" aria-hidden="true"></div>
    <div class="ph-cols">
      {p.phases.map((ph, i) => (
        <div class="ph-col">
          <span class="ph-label">{L.phases[i]}</span>
          <h3>{ph.title}</h3>
          <p>{ph.text}</p>
        </div>
      ))}
    </div>
    <p class="ph-foot">{p.phasesFoot}</p>
  </div>
</section>

<!-- CE QUE NOUS EXAMINONS -->
<section class="section">
  <div class="container">
    <SectionHeader eyebrow={L.examine} title={p.blocksTitle} center />
    {p.blocks.map((b, i) => (
      <div class:list={['block', b.visual ? ['split', { 'split--rev': i % 2 === 1 }] : 'block--text']}>
        <div class="split-text">
          <p class="eyebrow">{b.eyebrow}</p>
          <h3 class="block-title">{b.title}</h3>
          <p>{b.text}</p>
          {b.points && (
            <ul class="ticks">{b.points.map((pt) => <li><Icon name="check" size={17} /> <span>{pt}</span></li>)}</ul>
          )}
        </div>
        {b.visual && (
          <div class="split-media">
            {b.visual.src
              ? <img src={b.visual.src} alt={b.visual.alt ?? ''} loading="lazy" />
              : <div class="ph"><Icon name="file" size={28} /><span>{L.photo}</span><small>{b.visual.placeholder}</small></div>}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<!-- MANDAT RÉALISÉ -->
<section class="section section--dark" id="mandat">
  <div class="container split">
    <div class="split-media">
      {p.mandat.visual.src
        ? <img src={p.mandat.visual.src} alt={p.mandat.visual.alt ?? ''} loading="lazy" />
        : <div class="ph ph--dark"><Icon name="file" size={28} /><span>{L.photo}</span><small>{p.mandat.visual.placeholder}</small></div>}
    </div>
    <div class="split-text">
      <p class="eyebrow">{L.mandat} - {p.mandat.label}</p>
      <h2>{p.mandat.title}</h2>
      <dl class="case">
        <div><dt>{L.ctx}</dt><dd>{p.mandat.contexte}</dd></div>
        <div><dt>{L.mission}</dt><dd>{p.mandat.mission}</dd></div>
        <div><dt>{L.result}</dt><dd>{p.mandat.resultat}</dd></div>
      </dl>
      <p class="case-note">{L.caseNote}</p>
    </div>
  </div>
</section>

<!-- APERÇU DU LIVRABLE -->
<section class="section">
  <div class="container livr">
    <div class="split-text">
      <p class="eyebrow">{L.deliver}</p>
      <h2>{p.livrableTitle}</h2>
      <p class="lead">{p.livrableText}</p>
      <ul class="ticks">{p.livrables.map((l) => <li><Icon name="check" size={17} /> <span>{l}</span></li>)}</ul>
    </div>
    <ReportPreview />
  </div>
</section>

<!-- FAQ -->
<section class="section section--soft">
  <div class="container faq-wrap">
    <SectionHeader eyebrow={L.faqEyebrow} title={L.faqTitle} center />
    {p.faqs.map((f) => (
      <details class="faq-item">
        <summary><span>{f.q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
        <div class="faq-answer"><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>

{p.related.length > 0 && (
  <section class="section">
    <div class="container related-wrap">
      <p class="eyebrow">{L.relEyebrow}</p>
      <h2>{L.relTitle}</h2>
      <ul class="related-list">
        {p.related.map((r) => (
          <li><a href={r.slug.startsWith('/') ? r.slug : `/blog/${r.slug}`}><Icon name="arrow" size={16} /> {r.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
)}

<FinalCTA title={p.cta.title} text={p.cta.text} />

<style>
  /* HERO */
  .sh { position: relative; min-height: min(78vh, 720px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--navy); }
  .sh-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sh-bg--ph { display: flex; align-items: flex-start; justify-content: flex-end; padding: 110px 28px 0; background: repeating-linear-gradient(135deg, #1b2470 0 22px, #18205f 22px 44px); }
  .sh-bg--ph span { font-size: 13px; color: rgba(255,255,255,.75); border: 1px dashed rgba(255,255,255,.4); padding: 6px 12px; border-radius: 30px; position: relative; z-index: 3; }
  .sh-overlay { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(8,13,59,.94) 0%, rgba(13,20,90,.78) 45%, rgba(13,20,90,.35) 100%); }
  .sh-inner { position: relative; z-index: 2; padding-top: 140px; padding-bottom: 72px; max-width: 800px; margin-left: max(24px, calc((100vw - 1200px) / 2)); }
  .sh .eyebrow { color: var(--gold); }
  .sh h1 { color: #fff; font-size: clamp(2.1rem, 4.6vw, 3.4rem); margin-bottom: 18px; }
  .sh .lead { color: rgba(255,255,255,.9); max-width: 60ch; }
  .sh-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  /* REPÈRES */
  .reperes { background: #fff; border-bottom: 1px solid var(--border); padding: 30px 0; }
  .reperes-grid { display: grid; grid-template-columns: repeat(var(--n, 3), 1fr); gap: 24px; }
  .reperes-grid > div { text-align: center; position: relative; }
  .reperes-grid > div + div::before { content: ''; position: absolute; left: -12px; top: 50%; transform: translateY(-50%); width: 1px; height: 46px; background: var(--border); }
  .reperes-grid b { display: block; font-size: 1.45rem; font-weight: 700; color: var(--navy); line-height: 1.15; }
  .reperes-grid span { font-size: 13px; color: var(--text-muted); }

  /* SPLIT TEXTE / IMAGE */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .split--rev .split-media { order: -1; }
  .split-text h2 { margin-bottom: 16px; }
  .split-text p { color: var(--text-muted); }
  .split-text .lead { color: var(--text); }
  .split-media img, .ph { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); display: block; }
  .ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 24px; background: repeating-linear-gradient(135deg, #f3f4fa 0 20px, #eceef7 20px 40px); border: 2px dashed #c9cde3; box-shadow: none; color: var(--navy); }
  .ph span { font-weight: 700; }
  .ph small { color: var(--text-muted); max-width: 34ch; font-size: 13px; }
  .ph--dark { background: repeating-linear-gradient(135deg, #1b2470 0 20px, #18205f 20px 40px); border-color: rgba(255,255,255,.3); color: #fff; }
  .ph--dark small { color: rgba(255,255,255,.7); }
  .block { margin-top: 64px; }
  .enjeu--text { max-width: 820px; text-align: center; }
  .block-title { font-size: 1.5rem; color: var(--navy); margin-bottom: 12px; }
  .block--text { max-width: 760px; margin-left: auto; margin-right: auto; padding: 36px 40px; background: var(--soft); border-left: 4px solid var(--gold); border-radius: var(--radius-lg); }
  .ticks { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .ticks li { display: flex; gap: 11px; align-items: flex-start; font-weight: 500; color: var(--navy); }
  .ticks svg { color: var(--gold-strong); flex-shrink: 0; margin-top: 3px; }

  /* DÉROULÉ : flèche vert -> jaune -> rouge (pic au centre) -> orange */
  .ph-head { max-width: 760px; margin-bottom: 40px; }
  .ph-arrow { position: relative; height: 8px; margin-right: 18px; border-radius: 8px 0 0 8px; background: linear-gradient(90deg, #2f9e5e 0%, #a3c23a 22%, #e5b52a 38%, #c7362a 52%, #d9541f 72%, #e8822a 100%); }
  .ph-arrow::after { content: ''; position: absolute; right: -18px; top: 50%; transform: translateY(-50%); border-left: 20px solid #e8822a; border-top: 13px solid transparent; border-bottom: 13px solid transparent; }
  .ph-cols { display: grid; grid-template-columns: repeat(3, 1fr); }
  .ph-col { padding: 26px 28px 8px 0; }
  .ph-col + .ph-col { padding-left: 28px; border-left: 1px solid var(--border); }
  .ph-label { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .ph-col:nth-child(1) .ph-label { color: #2f8a55; }
  .ph-col:nth-child(2) .ph-label { color: #c7362a; }
  .ph-col:nth-child(3) .ph-label { color: #d46a1c; }
  .ph-col h3 { margin: 8px 0 10px; color: var(--navy); }
  .ph-col p { color: var(--text-muted); margin: 0; }
  .ph-foot { margin-top: 28px; font-weight: 600; color: var(--navy); }

  /* MANDAT */
  .section--dark .split-text p { color: rgba(255,255,255,.82); }
  .case { margin: 22px 0 0; display: flex; flex-direction: column; gap: 16px; }
  .case div { border-left: 3px solid var(--gold); padding-left: 16px; }
  .case dt { color: var(--gold); font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; }
  .case dd { margin: 0; color: rgba(255,255,255,.9); }
  .case-note { font-size: 13px; margin-top: 22px; font-style: italic; }

  /* LIVRABLE */
  .livr { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: 56px; align-items: center; }

  /* FAQ / LIENS */
  .faq-wrap { max-width: 820px; }
  .faq-item { border: 1px solid var(--border); border-radius: var(--radius-lg); background: #fff; overflow: hidden; margin-bottom: 12px; }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px; cursor: pointer; font-weight: 600; color: var(--navy); font-size: 1.05rem; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-plus { position: relative; width: 18px; height: 18px; flex-shrink: 0; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; background: var(--gold-strong); border-radius: 2px; transition: transform .2s ease; }
  .faq-plus::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq-plus::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq-item[open] .faq-plus::after { transform: scaleY(0); }
  .faq-answer { padding: 0 24px 22px; }
  .faq-answer p { color: var(--text-muted); margin: 0; line-height: 1.7; }
  .related-wrap { max-width: 820px; }
  .related-wrap h2 { margin-bottom: 20px; }
  .related-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .related-list a { display: inline-flex; align-items: baseline; gap: 10px; color: var(--navy); font-weight: 600; font-size: 1.05rem; }
  .related-list svg { color: var(--gold-strong); flex-shrink: 0; transform: translateY(2px); }

  @media (max-width: 820px) {
    .ph-cols { grid-template-columns: 1fr; }
    .ph-col + .ph-col { padding-left: 0; border-left: 0; border-top: 1px solid var(--border); }
    .split { grid-template-columns: 1fr; gap: 28px; }
    .split-media, .split--rev .split-media { order: -1; }
    .livr { grid-template-columns: 1fr; gap: 28px; }
    .reperes-grid { grid-template-columns: 1fr; gap: 16px; }
    .reperes-grid > div + div::before { display: none; }
    .sh { min-height: 70vh; }
    .sh-inner { margin-left: 0; }
  }
</style>

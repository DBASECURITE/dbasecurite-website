---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} - ${site.tagline}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  logo: new URL('/assets/logo-dba-color.png', site.url).href,
  image: new URL('/assets/logo-dba-color.png', site.url).href,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: '1251',
    addressLocality: 'Gy',
    addressRegion: 'Genève',
    addressCountry: 'CH',
  },
  areaServed: ['Genève', 'Suisse romande', 'Suisse'],
  sameAs: [site.linkedin],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="theme-color" content="#ffffff" />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/logo-dba-color.png', site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_CH" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {site.plausibleDomain && (
      <script defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 8px;
        background: var(--brand);
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        z-index: 100;
      }
      .skip-link:focus { left: 12px; }
    </style>
  </body>
</html>
